# LS Web Agency — variabili d'ambiente
#
# Copia questo file in `.env` e compila i valori.
# `.env` è ignorato da git: non deve MAI essere committato.
# In produzione i valori si impostano dalle Environment Variables di Vercel.

# --- Database / CRM (Supabase) ---
# SUPABASE_SERVICE_ROLE scavalca le Row Level Security: solo lato server, mai esposta al client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=

# --- Invio email transazionali (Resend) ---
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=
MAIL_SUBJECT_PREFIX=

# --- Form contatti: mittente e destinatari ---
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=
CONTACT_TO_EMAIL=
CONTACT_TO=
# Abilita l'invio email anche nelle preview Vercel: impostare a "true" solo se serve.
CONTACT_ALLOW_EMAIL_IN_PREVIEW=

# --- SMTP alternativo (fallback a Resend) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# --- Prospecting (scripts/prospecting/run.mjs) ---
# Chiave Google Places API v1, usata solo dallo script CLI di discovery.
GOOGLE_PLACES_API_KEY=

# --- Variabili pubbliche (esposte al browser: non inserire qui alcun segreto) ---
PUBLIC_GA4_ID=
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_WHATSAPP_SALES=
PUBLIC_WHATSAPP_DEMO_LINK=
PUBLIC_ONBOARDING_FORM_URL=
PUBLIC_ONBOARDING_CALENDAR_URL=
