---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Archivo C3', 'Inter Variable';

    /* Redesign C.3 «Kinetic Graphite»: primary ione profondo #1F5A54,
       hover #184641, accent ione #267A70 (testo bianco ≥ 5,5:1) */
    --aw-color-primary: 31 90 84;
    --aw-color-secondary: 24 70 65;
    --aw-color-accent: 38 122 112;

    --aw-color-text-heading: rgb(22 25 28);
    --aw-color-text-default: rgb(22 25 28);
    --aw-color-text-muted: rgb(22 25 28 / 70%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(13 15 17);

    ::selection {
      background-color: #8fd3c8;
      color: #0d0f11;
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Archivo C3', 'Inter Variable';

    /* su fondo grafite il principale diventa ione chiaro (testo scuro sopra) */
    --aw-color-primary: 31 90 84;
    --aw-color-secondary: 24 70 65;
    --aw-color-accent: 143 211 200;

    --aw-color-text-heading: rgb(237 236 232);
    --aw-color-text-default: rgb(237 236 232);
    --aw-color-text-muted: rgb(237 236 232 / 70%);
    --aw-color-bg-page: rgb(13 15 17);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
