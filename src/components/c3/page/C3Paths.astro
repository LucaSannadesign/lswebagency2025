---
/**
 * Doppio percorso finale delle pagine interne:
 * 1. valutazione iniziale gratuita (percorso esistente, /mini-analisi);
 * 2. progetto strutturato o collaborazione (sezione dedicata in /contatti).
 * Più un rimando per agenzie e partner (white label, pagina esistente).
 */
import C3Section from './C3Section.astro';

export interface Props {
  tone?: 'dark' | 'deep' | 'anth' | 'ivory';
  index?: string;
  title?: string;
}
const { tone = 'deep', index, title = 'Come vuoi iniziare?' } = Astro.props;
---

<C3Section tone={tone} id="percorsi" index={index} kicker="Due percorsi" title={title} accent="iniziare?" glow>
  <div class="c3-paths">
    <a class="c3-path c3-up" href="/mini-analisi">
      <span class="c3-path-k">Per orientarti · gratuita</span>
      <h3>Valutazione iniziale</h3>
      <p>Rispondi a poche domande sul sito o sulla tua idea per individuare le priorità e capire quale intervento valutare.</p>
      <span class="c3-path-go">Avvia la valutazione <span aria-hidden="true">→</span></span>
    </a>
    <a class="c3-path c3-path--accent c3-up" href="/contatti#progetto-strutturato">
      <span class="c3-path-k">Per nuovi progetti e collaborazioni</span>
      <h3>Parliamo del tuo progetto</h3>
      <p>Un nuovo sito, un prodotto digitale o un’interfaccia da progettare e sviluppare su misura, con obiettivi, tempi e budget da definire insieme.</p>
      <ul>
        <li>Brief e obiettivi, anche in forma di bozza</li>
        <li>Proposta con fasi, tempi e preventivo</li>
      </ul>
      <span class="c3-path-go">Descrivi il progetto <span aria-hidden="true">→</span></span>
    </a>
  </div>
  <p class="c3-paths-note c3-up">
    Sei un’agenzia o un partner tecnologico? <a href="/servizi/sviluppo-web-white-label">Collaborazioni e sviluppo white label</a>
  </p>
</C3Section>
