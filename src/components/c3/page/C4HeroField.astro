---
/**
 * Ion Field — variante vettoriale del linguaggio Vortex Field della home.
 * Fallback SVG deterministico; canvas animato opzionale su desktop.
 */
interface Props { variant?: 'field' | 'flow' | 'geometry' | 'sculpture'; }
const { variant = 'field' } = Astro.props;
const strands = Array.from({ length: 44 }, (_, i) => {
  const u = i / 43;
  const points = Array.from({ length: 65 }, (_, j) => {
    const t = j / 64;
    const wave = Math.sin(t * Math.PI * 2.35 + u * 1.7);
    const envelope = Math.sin(t * Math.PI) ** 1.2;
    const curl = Math.sin(t * Math.PI * 2.6 - u * 2.2);
    const x = -65 + t * 1130 + 42 * envelope * Math.sin(t * Math.PI * 2 + u * 2.8);
    const y = 174 - 96 * t + (u - .5) * (120 - 55 * envelope) + envelope * (54 * wave + 24 * curl);
    return `${j === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
  });
  return { d: points.join(' '), opacity: .19 + .48 * Math.sin(Math.PI * u), width: i % 7 === 0 ? 1.65 : .8 };
});
---

<div class="c4-phero-field" data-c4-field={variant} data-c4-state="fallback">
  <div class="c4-field-art" aria-hidden="true">
  <svg viewBox="0 0 1000 240" preserveAspectRatio="xMidYMid slice" fill="none" focusable="false" aria-hidden="true">
    {strands.map((line) => (
      <path d={line.d} stroke="currentColor" stroke-opacity={line.opacity} stroke-width={line.width} stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
    ))}
  </svg>
  <canvas data-c4-canvas aria-hidden="true"></canvas>
  </div>
  <button type="button" class="c4-field-toggle" data-c4-pause hidden aria-pressed="false" aria-label="Pausa animazione della testata"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path class="c4-pause-icon" d="M7 4v12M13 4v12"/><path class="c4-play-icon" d="m7 4 9 6-9 6Z"/></svg><span data-c4-motion-label>Pausa</span></button>
</div>
<script>
  import "@/scripts/c3/ion-flow";
</script>
