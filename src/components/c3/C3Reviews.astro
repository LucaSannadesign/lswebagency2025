---
/**
 * Recensioni Google: una in evidenza + carosello con scroll-snap e frecce
 * (interazione recuperata dalla homepage precedente). Tutte le 9 recensioni.
 */
import { REVIEWS, GOOGLE_REVIEWS_URL } from '@/data/c3/home';

const [featured, ...rest] = REVIEWS;
---

<section class="c3-band c3-revs-band" id="recensioni" data-c3-chapter="dark" aria-labelledby="c3-h-rec">
  <div class="c3-revs-head">
    <div>
      <p class="c3-kicker"><span class="c3-idx" aria-hidden="true">05</span>Recensioni Google</p>
      <h2 class="c3-h2" id="c3-h-rec">Cosa dicono le attività con cui ho lavorato.</h2>
    </div>
    <a class="c3-btn c3-btn--s" href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener noreferrer">
      Tutte le recensioni su Google
    </a>
  </div>

  {
    featured && (
      <figure class="c3-rev-big">
        <span class="c3-stars" role="img" aria-label="5 stelle su 5">
          ★★★★★
        </span>
        <blockquote>
          <p>«{featured.text}»</p>
        </blockquote>
        <figcaption>
          <strong>{featured.author}</strong>
          {featured.context && <>, {featured.context}</>}
        </figcaption>
      </figure>
    )
  }

  <div class="c3-car" data-c3-carousel>
    <div class="c3-car-ctrl">
      <button type="button" class="c3-icon-btn" aria-label="Recensione precedente" data-prev>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
      </button>
      <span class="c3-car-count" aria-hidden="true" data-count>1 / {rest.length}</span>
      <button type="button" class="c3-icon-btn" aria-label="Recensione successiva" data-next>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </button>
    </div>
    <ul class="c3-car-track" data-track tabindex="0" aria-label="Altre recensioni, scorri orizzontalmente">
      {
        rest.map((r) => (
          <li class="c3-rev" data-card>
            <span class="c3-stars" role="img" aria-label="5 stelle su 5">
              ★★★★★
            </span>
            <blockquote {...(r.lang ? { lang: r.lang } : {})}>
              <p>«{r.text}»</p>
            </blockquote>
            <p class="c3-rev-a">{r.author}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
