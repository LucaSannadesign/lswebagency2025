---
import PostTags from '@/components/blog/Tags.astro';
import SocialShare from '@/components/common/SocialShare.astro';
import PostCTA from '@/components/blog/PostCTA.astro';
import { getFormattedDate } from '@/utils/utils';
import { getPostImageForComponent } from '@/utils/blog';
import { findImage } from '@/utils/images';
import type { ImageMetadata } from 'astro';
import '@/styles/c3/pages.css';

export interface Props {
  post: Record<string, any>;
  url: string | URL;
}

const { post, url } = Astro.props;

// Titolo
const title: string = post?.title ?? 'Articolo';

// Normalizzazione cover: accetta string (/public), ImageMetadata, oggetti annidati {src:{src,...}} o {url,...}
let coverSrc: string | null = null;
let coverW: number | undefined;
let coverH: number | undefined;
let coverAlt: string =
  post?.imageAlt ||
  post?.image?.alt ||
  post?.title ||
  'Immagine dell’articolo';

// 1) Stringa (es. "/images/cover.webp")
if (typeof post?.image === 'string') {
  coverSrc = post.image;
}

// 2) Oggetto con .src (ImageMetadata)
if (!coverSrc && post?.image && typeof post.image === 'object' && typeof post.image.src === 'string') {
  coverSrc = (post.image as ImageMetadata).src;
  coverW = (post.image as any).width;
  coverH = (post.image as any).height;
}

// 3) Annidato .src.src
if (!coverSrc && post?.image?.src && typeof post.image.src === 'object' && typeof post.image.src.src === 'string') {
  coverSrc = post.image.src.src;
  coverW = post.image.src.width;
  coverH = post.image.src.height;
}

// 4) Oggetto tipo { url, width, height }
if (!coverSrc && post?.image && typeof post.image.url === 'string') {
  coverSrc = post.image.url;
  coverW = (post.image as any).width;
  coverH = (post.image as any).height;
}

// dimensioni fallback sicure (niente CLS con /public)
if (!coverW) coverW = Number(post?.imageWidth) || undefined;
if (!coverH) coverH = Number(post?.imageHeight) || undefined;

const hasExplicitDimensions = Boolean(coverW && coverH);

// URL per lo share
const shareUrl = typeof url === 'string' ? url : url?.toString?.() ?? '';
---

<!-- Redesign C.3.4: testata scura editoriale, colonna di lettura che segue il tema
     (avorio in chiaro, grafite in scuro). H1, contenuto, CTA, tag e share invariati. -->
<article class="c3 c3p c3-article">
  <header class="c3-sec c3-sec--dark c3-phero c3-ahero">
    <div class="c3-ahero-in">
      <p class="c3-post-meta c3-ahero-meta">
        {post.category && <span class="c3-post-cat">{post.category.title}</span>}
        <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
        {post.readingTime && <span>{post.readingTime} min di lettura</span>}
        {post.author && <span>{post.author}</span>}
      </p>

      <h1 class="c3-phero-title c3-ahero-title">{title}</h1>

      {post.excerpt && <p class="c3-lead c3-ahero-lead">{post.excerpt}</p>}
    </div>
  </header>

  <div class="c3-sec c3-sec--read c3-article-body">
    <div class="c3-article-in">
      {coverSrc && (
        <figure class="c3-article-cover">
          <img
            src={coverSrc}
            alt={coverAlt}
            {...(hasExplicitDimensions ? { width: coverW, height: coverH } : {})}
            loading="eager"
            decoding="async"
          />
        </figure>
      )}

      <div class="prose prose-lg lg:prose-xl max-w-none c3-article-prose">
        <slot />
      </div>

      {!post.hideDefaultCTA && <PostCTA />}

      <div class="c3-article-foot">
        <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
        <SocialShare url={shareUrl} text={title} class="sm:mt-0 align-middle" />
      </div>
    </div>
  </div>
</article>
