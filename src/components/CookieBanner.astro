---
const CONSENT_KEY = 'ls_cookie_consent_v1';
---

<div id="cookie-banner" class="fixed inset-x-0 bottom-0 z-[60] hidden">
  <div class="mx-auto max-w-screen-xl px-3 sm:px-4 md:px-8 pb-3 sm:pb-4">
    <div class="rounded-2xl border border-slate-200 bg-white/95 backdrop-blur shadow-2xl
                dark:border-slate-800 dark:bg-slate-950/85">
      <div class="p-3 sm:p-4 md:p-6 grid gap-3 md:gap-4 md:grid-cols-[1fr_auto] md:items-center">
        <div class="space-y-1.5 sm:space-y-2">
          <p class="text-[11px] sm:text-sm font-semibold tracking-[0.18em] uppercase text-slate-500 dark:text-slate-400">
            Cookie e preferenze
          </p>

          <p class="text-sm sm:text-base md:text-lg text-slate-700 dark:text-slate-200 leading-snug sm:leading-normal">
            Usiamo cookie necessari. Con il tuo consenso attiviamo anche cookie
            <strong>statistici</strong>.
          </p>

          <p class="text-[12px] sm:text-sm text-slate-500 dark:text-slate-400">
            Leggi la <a class="underline underline-offset-4" href="/cookie">Cookie Policy</a>.
          </p>
        </div>

        <!-- ✅ Mobile compact: griglia, bottoni piccoli -->
        <div class="grid grid-cols-2 gap-2 md:flex md:flex-wrap md:justify-end md:gap-2">
          <button id="cookie-reject" class="btn-secondary btn-compact w-full !py-2 !px-3 text-sm">
            Rifiuta
          </button>

          <button id="cookie-prefs" class="btn-secondary btn-compact w-full !py-2 !px-3 text-sm">
            Preferenze
          </button>

          <!-- su mobile occupa 2 colonne: decisione principale chiara, ma non “gigante” -->
          <button id="cookie-accept" class="btn-primary btn-compact col-span-2 w-full !py-2.5 !px-3 text-sm">
            Accetta
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal preferenze -->
<div id="cookie-modal" class="fixed inset-0 z-[70] hidden">
  <div class="absolute inset-0 bg-black/40"></div>

  <!-- ✅ Mobile: margini e altezza controllati + scroll interno -->
  <div class="relative mx-auto my-6 w-[min(92vw,720px)]
              max-h-[calc(100vh-3rem)] overflow-hidden
              rounded-2xl border border-slate-200 bg-white shadow-2xl
              dark:border-slate-800 dark:bg-slate-950">
    <div class="p-4 sm:p-5 md:p-6 overflow-auto max-h-[calc(100vh-3rem)]">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 class="text-lg sm:text-xl font-semibold text-slate-900 dark:text-slate-100">Preferenze cookie</h2>
          <p class="mt-1.5 text-sm sm:text-base text-slate-600 dark:text-slate-300">
            Scegli quali categorie attivare. I cookie necessari restano sempre attivi.
          </p>
        </div>

        <button id="cookie-close" class="btn-secondary btn-compact !py-2 !px-3 text-sm">
          Chiudi
        </button>
      </div>

      <div class="mt-4 sm:mt-6 space-y-3 sm:space-y-4">
        <label class="flex items-center justify-between gap-4 rounded-xl border border-slate-200 p-3 sm:p-4 dark:border-slate-800">
          <div>
            <p class="font-semibold text-slate-900 dark:text-slate-100 text-sm sm:text-base">Necessari</p>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">Sempre attivi (sicurezza, funzioni base).</p>
          </div>
          <input type="checkbox" checked disabled class="h-5 w-5" />
        </label>

        <label class="flex items-center justify-between gap-4 rounded-xl border border-slate-200 p-3 sm:p-4 dark:border-slate-800">
          <div>
            <p class="font-semibold text-slate-900 dark:text-slate-100 text-sm sm:text-base">Statistiche (Analytics)</p>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">Misura visite e performance in forma aggregata.</p>
          </div>
          <input id="cookie-analytics" type="checkbox" class="h-5 w-5" />
        </label>

      </div>

      <div class="mt-4 sm:mt-6 flex justify-end">
        <button id="cookie-save" class="btn-primary btn-compact !py-2.5 !px-4 text-sm sm:text-base">
          Salva preferenze
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // IIFE: nessuna variabile globale, quindi nessuna ridichiarazione se lo script
  // viene rieseguito durante una navigazione con Astro ClientRouter.
  (function () {
    var KEY = 'ls_cookie_consent_v1';

    function readConsent() {
      try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; }
    }

    // Google Consent Mode v2: il default 'denied' è impostato nel <head> prima di GTM.
    // Qui si aggiorna solo analytics_storage; gli stati pubblicitari restano negati.
    function updateGoogleConsent(consent) {
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'update', {
        analytics_storage: consent && consent.analytics ? 'granted' : 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
    }

    function writeConsent(consent) {
      localStorage.setItem(KEY, JSON.stringify(consent));
      document.cookie = "ls_cookie_consent=" + encodeURIComponent(JSON.stringify(consent)) + "; Path=/; Max-Age=31536000; SameSite=Lax";
      updateGoogleConsent(consent);
      window.dispatchEvent(new CustomEvent('ls:cookieconsent', { detail: consent }));
    }

    // Riapertura del pannello preferenze. Definita fuori da initCookieBanner così
    // da restare valida anche dopo le sostituzioni del DOM: rilegge sempre gli elementi.
    function openPreferences() {
      var modal = document.getElementById('cookie-modal');
      if (!modal) return;
      var chkAnalytics = document.getElementById('cookie-analytics');
      var c = readConsent() || { analytics: false, marketing: false, ts: Date.now() };
      if (chkAnalytics) chkAnalytics.checked = !!c.analytics;
      modal.classList.remove('hidden');
      if (chkAnalytics) chkAnalytics.focus();
    }

    // Rieseguibile su ogni nuovo DOM. L'attributo data-cookie-bound garantisce
    // che i listener siano collegati una sola volta per nodo.
    function initCookieBanner() {
      var banner = document.getElementById('cookie-banner');
      if (!banner) return;
      if (banner.dataset.cookieBound === '1') return;
      banner.dataset.cookieBound = '1';

      var modal        = document.getElementById('cookie-modal');
      var btnAccept    = document.getElementById('cookie-accept');
      var btnReject    = document.getElementById('cookie-reject');
      var btnPrefs     = document.getElementById('cookie-prefs');
      var btnClose     = document.getElementById('cookie-close');
      var btnSave      = document.getElementById('cookie-save');
      var chkAnalytics = document.getElementById('cookie-analytics');

      function hideBanner() { banner.classList.add('hidden'); }
      function closeModal() { if (modal) modal.classList.add('hidden'); }
      function openModal() { openPreferences(); }
      function decide(analytics) {
        writeConsent({ analytics: analytics, marketing: false, ts: Date.now() });
        hideBanner();
        closeModal();
      }

      // Stato coerente con la scelta già salvata, anche dopo uno swap di pagina.
      if (readConsent()) hideBanner(); else banner.classList.remove('hidden');

      if (btnAccept) btnAccept.addEventListener('click', function () { decide(true); });
      if (btnReject) btnReject.addEventListener('click', function () { decide(false); });
      if (btnPrefs)  btnPrefs.addEventListener('click', openModal);
      if (btnClose)  btnClose.addEventListener('click', closeModal);
      if (btnSave)   btnSave.addEventListener('click', function () { decide(!!(chkAnalytics && chkAnalytics.checked)); });
      if (modal)     modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
    }

    initCookieBanner();

    // Listener globali registrati una sola volta, anche se lo script venisse rieseguito.
    if (!window.__lsCookieBannerBooted) {
      window.__lsCookieBannerBooted = true;
      document.addEventListener('astro:after-swap', initCookieBanner);

      // Delegato sul document: resta valido dopo ogni sostituzione del DOM.
      document.addEventListener('click', function (e) {
        var trigger = e.target && e.target.closest ? e.target.closest('[data-cookie-preferences]') : null;
        if (!trigger) return;
        e.preventDefault();
        openPreferences();
      });

      // Chiusura da tastiera del pannello preferenze.
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        var modal = document.getElementById('cookie-modal');
        if (modal && !modal.classList.contains('hidden')) modal.classList.add('hidden');
      });

      // Compatibilità con i pulsanti già presenti che invocano questa funzione.
      window.__openConsentBanner = openPreferences;
    }
  })();
</script>