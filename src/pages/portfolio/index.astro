---
/**
 * /portfolio · Redesign C.3.4
 * 1. I quattro progetti in evidenza (PreventivoDentale, Canapalandia, LUGHE,
 *    YoArtly), sempre presenti indipendentemente dalla data.
 * 2. Archivio con stato dichiarato e paginazione invariata (/portfolio/page/N).
 * Invariati: metadata, H1 «Portfolio», URL dei case study.
 */
import Layout from '@/layouts/PageLayout.astro';
import C3PageHero from '@/components/c3/page/C3PageHero.astro';
import C3Section from '@/components/c3/page/C3Section.astro';
import C3Archive from '@/components/c3/page/C3Archive.astro';
import C3Paths from '@/components/c3/page/C3Paths.astro';
import { getPortfolio, PER_PAGE } from '@/data/c3/portfolio-archive';
import { statusOf, statusLabel, type PortfolioCardData } from '@/data/c3/portfolio-status';
import { PORTFOLIO, shotSrcset } from '@/data/c3/home';

const metadata = {
  title: 'Portfolio Progetti Web | LS Web Agency',
  description: 'Siti cliente attivi, progetti digitali indipendenti e case study storici: portfolio LS Web Agency con stato dei lavori verificato.',
  canonical: '/portfolio',
  openGraph: { url: '/portfolio', type: 'website' },
};

const { all, featured, archive, totalPages, counts } = await getPortfolio();
const pageItems = archive.slice(0, PER_PAGE);
const extra = new Map(PORTFOLIO.map((p) => [p.id, p]));
const featuredView = featured.map((e) => ({ id: e.id, d: e.data as PortfolioCardData, x: extra.get(e.id) }));
---

<Layout metadata={metadata} headerTone="dark">
  <div class="c3 c3p">
    <C3PageHero visual="geometry"
      kicker="Lavori"
      title="Portfolio"
      accent="Portfolio"
      lead="Una selezione di progetti che uniscono identità visiva, esperienza utente e sviluppo web. Ogni scheda racconta il lavoro svolto e distingue i siti per clienti, i progetti indipendenti e quelli di archivio."
      actions={[
        { text: 'Progetti in evidenza', href: '#in-evidenza', variant: 'secondary' },
        { text: 'Archivio completo', href: '#archivio', variant: 'secondary' },
      ]}
    >
      <dl class="c3-meta" slot="aside">
        <div><dt>Progetti</dt><dd>{all.length} schede pubblicate</dd></div>
        <div><dt>In evidenza</dt><dd>PreventivoDentale, Canapalandia, LUGHE, YoArtly</dd></div>
        <div><dt>Stati</dt><dd>dichiarati su ogni scheda, senza risultati non verificati</dd></div>
      </dl>
    </C3PageHero>

    <C3Section
      tone="dark"
      id="in-evidenza"
      index="01"
      kicker="In evidenza"
      title="Quattro progetti, dall’identità al codice."
      accent="al codice."
    >
      <div class="c3-feat">
        {
          featuredView.map(({ id, d, x }, i) => {
            return (
              <article class="c3-feat-item c3-up" aria-labelledby={`feat-${id}`}>
                <figure class="c3-feat-fig">
                  <img
                    src={x?.shot ?? d.image?.src}
                    srcset={shotSrcset(x?.shot)}
                    sizes="(min-width: 1440px) 713px, (min-width: 1024px) 50vw, 90vw"
                    alt={x ? `Homepage del sito ${x.domain}` : (d.image?.alt ?? d.title)}
                    width="800"
                    height="500"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </figure>
                <div>
                  <span class="c3-feat-n" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <span class="c3-status" data-s={statusOf(d)}>
                      {statusLabel(d)}
                    </span>
                  </div>
                  {x?.logo && (
                    <span class="c3-feat-logo">
                      <img src={x.logo} alt={`Logo ${x.name}`} height="28" loading="lazy" />
                    </span>
                  )}
                  <h3 id={`feat-${id}`}>{x?.name ?? d.title}</h3>
                  <p>{d.description}</p>
                  {x?.role && (
                    <p>
                      <strong>Ruolo:</strong> {x.role}
                    </p>
                  )}
                  <div class="c3-feat-links">
                    <a class="c3-btn c3-btn--p" href={`/portfolio/${d.slug}`}>
                      Leggi il case study
                    </a>
                    {x?.url && (
                      <a class="c3-btn c3-btn--s" href={x.url} target="_blank" rel="noopener">
                        Visita {x.domain} ↗
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </C3Section>

    <C3Archive items={pageItems} counts={counts} currentPage={1} totalPages={totalPages} index="02" />

    <C3Paths index="03" title="Diamo forma al tuo prossimo progetto." />
  </div>
</Layout>
