---
/**
 * Case study · Redesign C.3.4
 * Struttura: testata con scheda dati (stato, categoria, ruolo, tecnologie,
 * sito) → copertina → lettura con indice dei capitoli (dal corpo MDX) →
 * risultati dichiarati onestamente → navigazione progetti → doppio percorso.
 * Invariati: metadata dal frontmatter, H1 = titolo, contenuto MDX integrale,
 * prev/next, prerender. Nessuna metrica aggiunta.
 */
import Layout from '@/layouts/PageLayout.astro';
import { getCollection, render as renderEntry } from 'astro:content';
import type { MetaData } from '@/types';
import C3PageHero from '@/components/c3/page/C3PageHero.astro';
import C3Section from '@/components/c3/page/C3Section.astro';
import C3Paths from '@/components/c3/page/C3Paths.astro';
import MdxH1AsH2 from '@/components/c3/page/MdxH1AsH2.astro';
import { statusOf, statusLabel } from '@/data/c3/portfolio-status';
import { PORTFOLIO } from '@/data/c3/home';
export const prerender = true;

const toDate = (v: unknown) => (v instanceof Date ? v : typeof v === 'string' && v ? new Date(v) : new Date(0));

export async function getStaticPaths() {
  const all = await getCollection('portfolio');
  return all.filter((e) => !!e.data?.slug).map((e) => ({ params: { slug: String(e.data.slug) } }));
}

const { slug } = Astro.params;
const all = await getCollection('portfolio');
const ordered = all.slice().sort((a, b) => {
  const byDate = toDate(b.data?.publishDate).getTime() - toDate(a.data?.publishDate).getTime();
  if (byDate !== 0) return byDate;
  return String(a.data?.slug || '').localeCompare(String(b.data?.slug || ''));
});
const entry = ordered.find((e) => String(e.data?.slug) === String(slug));
if (!entry) {
  throw new Error(`Portfolio non trovato: ${slug}`);
}
const d = entry.data;
const { Content, headings } = await renderEntry(entry);

const idx = ordered.findIndex((e) => String(e.data?.slug) === String(slug));
const prev = idx > 0 ? ordered[idx - 1] : null;
const next = idx < ordered.length - 1 ? ordered[idx + 1] : null;

const rawRobots = d.metadata?.robots;
const metadata: MetaData = {
  ...(d.metadata ?? {}),
  title: d.metadata?.title ?? d.title,
  description: d.metadata?.description ?? d.description,
  robots: typeof rawRobots === 'string' ? undefined : rawRobots,
};

// Dati di presentazione dei 4 progetti principali (ruolo, sito, funzionalità visibili)
const x = PORTFOLIO.find((p) => p.id === entry.id);
const status = statusOf(d);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 1);
const cover = x
  ? { src: x.shot, alt: `Homepage del sito ${x.domain}`, contain: false, w: 800, h: 500 }
  : d.image?.src
    ? { src: d.image.src, alt: d.image.alt ?? d.title, contain: d.image.fit === 'contain', w: d.image.width ?? 1200, h: d.image.height ?? 800 }
    : null;
---

<Layout metadata={metadata} headerTone="dark">
  <div class="c3 c3p">
    <C3PageHero kicker={d.category ?? 'Case study'} title={d.title} size="l" lead={d.description}>
      {d.statusNote && <p class="c3-note">{d.statusNote}</p>}
      <dl class="c3-meta" slot="aside">
        <div>
          <dt>Stato</dt>
          <dd><span class="c3-status" data-s={status}>{statusLabel(d)}</span></dd>
        </div>
        {d.category && (<div><dt>Categoria</dt><dd>{d.category}</dd></div>)}
        {x?.role && (<div><dt>Ruolo</dt><dd>{x.role}</dd></div>)}
        {Array.isArray(d.technologies) && d.technologies.length > 0 && (<div><dt>Tecnologie</dt><dd>{d.technologies.join(' · ')}</dd></div>)}
        {x?.url && (
          <div>
            <dt>Sito</dt>
            <dd><a class="c3-link" href={x.url} target="_blank" rel="noopener">{x.domain} ↗</a></dd>
          </div>
        )}
      </dl>
    </C3PageHero>

    {
      cover && (
        <div class="c3-sec c3-sec--ivory c3-cover-band">
          <div class="c3-sec-in">
            <figure class:list={['c3-cover', { 'is-contain': cover.contain }]}>
              <img src={cover.src} alt={cover.alt} width={cover.w} height={cover.h} loading="eager" decoding="async" />
            </figure>
          </div>
        </div>
      )
    }

    <section class="c3-sec c3-sec--ivory" aria-label="Racconto del progetto">
      <div class="c3-reading">
        <nav class="c3-toc" aria-label="Capitoli del case study">
          {
            toc.length > 1 && (
              <>
                <p>Capitoli</p>
                <ol>
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ol>
              </>
            )
          }
        </nav>
        <div class="c3-prose">
          <Content components={{ h1: MdxH1AsH2 }} />
        </div>
      </div>
    </section>

    <C3Section tone="anth" id="risultati" kicker="Risultati" title="Cosa è documentato.">
      <div class="c3-results">
        <div class="c3-up">
          {
            x ? (
              <>
                <h3 class="c3-mega-name" style="font-size:24px;margin:0 0 16px">Funzionalità realizzate e visibili sul sito</h3>
                <ul>
                  {x.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </>
            ) : (
              <p class="c3-lead" style="margin:0">
                La scheda descrive il progetto, il ruolo svolto e le scelte di design e sviluppo come riportati nel racconto.
              </p>
            )
          }
        </div>
        <div class="c3-up">
          <p class="c3-note" style="margin-top:0">
            I risultati quantitativi (traffico, contatti, vendite) sono riportati solo quando misurati e verificabili.
            {d.statusNote ? ' ' + d.statusNote : ''}
          </p>
        </div>
      </div>
    </C3Section>

    <section class="c3-sec c3-sec--dark c3-sec--tight" aria-label="Altri progetti">
      <div class="c3-sec-in">
        <nav class="c3-pnav" aria-label="Progetto precedente e successivo">
          {
            prev ? (
              <a href={`/portfolio/${prev.data.slug}`}>
                <small>← Progetto più recente</small>
                <strong>{prev.data.title}</strong>
              </a>
            ) : (
              <a href="/portfolio">
                <small>← Portfolio</small>
                <strong>Tutti i progetti</strong>
              </a>
            )
          }
          {
            next ? (
              <a class="is-next" href={`/portfolio/${next.data.slug}`}>
                <small>Progetto precedente →</small>
                <strong>{next.data.title}</strong>
              </a>
            ) : (
              <a class="is-next" href="/portfolio">
                <small>Portfolio →</small>
                <strong>Tutti i progetti</strong>
              </a>
            )
          }
        </nav>
      </div>
    </section>

    <C3Paths />
  </div>
</Layout>
