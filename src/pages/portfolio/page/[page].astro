---
/**
 * /portfolio/page/N · Redesign C.3.4
 * Stesso archivio di /portfolio (esclusi i 4 progetti in evidenza), 12 per
 * pagina. URL, title, description e canonical invariati nel formato.
 */
import Layout from '@/layouts/PageLayout.astro';
import C3PageHero from '@/components/c3/page/C3PageHero.astro';
import C3Archive from '@/components/c3/page/C3Archive.astro';
import C3Paths from '@/components/c3/page/C3Paths.astro';
import { getPortfolio, PER_PAGE } from '@/data/c3/portfolio-archive';

export async function getStaticPaths() {
  const { totalPages } = await getPortfolio();
  const paths: { params: { page: string } }[] = [];
  for (let p = 2; p <= totalPages; p++) paths.push({ params: { page: String(p) } });
  return paths;
}

const { archive, totalPages, counts } = await getPortfolio();
const pageParam = Number.parseInt(Astro.params.page ?? '2', 10);
const currentPage = Number.isFinite(pageParam) && pageParam >= 2 ? pageParam : 2;
const items = archive.slice((currentPage - 1) * PER_PAGE, currentPage * PER_PAGE);

const metadata = {
  title: `Portfolio — Pagina ${currentPage}`,
  description: `Progetti realizzati da LS Web Agency — pagina ${currentPage} di ${totalPages}.`,
  canonical: `/portfolio/page/${currentPage}`,
};
---

<Layout metadata={metadata} headerTone="dark">
  <div class="c3 c3p">
    <C3PageHero
      kicker="Lavori"
      title={`Portfolio — pagina ${currentPage}`}
      accent="Portfolio"
      size="l"
      lead="Archivio dei progetti con lo stato dichiarato su ogni scheda."
      actions={[{ text: '← Torna ai progetti in evidenza', href: '/portfolio', variant: 'secondary' }]}
    />
    <C3Archive items={items} counts={counts} currentPage={currentPage} totalPages={totalPages} />
    <C3Paths />
  </div>
</Layout>
