---
/**
 * /portfolio/page/N · Redesign C.3.4
 * Stesso archivio di /portfolio (esclusi i 4 progetti in evidenza), 12 per
 * pagina. URL, title, description e canonical invariati nel formato.
 */
import Layout from '@/layouts/PageLayout.astro';
import C3PageHero from '@/components/c3/page/C3PageHero.astro';
import C3Archive from '@/components/c3/page/C3Archive.astro';
import C3Paths from '@/components/c3/page/C3Paths.astro';
import { getPortfolio, PER_PAGE } from '@/data/c3/portfolio-archive';

const { all, archive, totalPages, counts } = await getPortfolio();
const rawPage = Astro.params.page ?? '';
const pageParam = /^[1-9]\d*$/.test(rawPage) ? Number(rawPage) : NaN;
if (pageParam === 1) return Astro.redirect('/portfolio', 301);
// Preserve formerly valid archive pages if highlighting projects reduces the page count.
const formerPages = Math.max(1, Math.ceil(all.length / PER_PAGE));
if (Number.isSafeInteger(pageParam) && pageParam > totalPages && pageParam <= formerPages) {
  return Astro.redirect(totalPages === 1 ? '/portfolio#archivio' : `/portfolio/page/${totalPages}`, 301);
}
const invalid = !Number.isSafeInteger(pageParam) || pageParam < 2 || pageParam > totalPages;
if (invalid) Astro.response.status = 404;
const currentPage = invalid ? 2 : pageParam;
const items = archive.slice((currentPage - 1) * PER_PAGE, currentPage * PER_PAGE);

const metadata = invalid ? {
  title: 'Pagina non trovata (404)',
  description: 'La pagina richiesta non esiste.',
  robots: { index: false, follow: true },
} : {
  title: `Portfolio — Pagina ${currentPage}`,
  description: `Progetti realizzati da LS Web Agency — pagina ${currentPage} di ${totalPages}.`,
  canonical: `/portfolio/page/${currentPage}`,
};
---

<Layout metadata={metadata} headerTone="dark">
  {invalid ? (
    <section class="min-h-[60vh] flex items-center justify-center px-6 text-center">
      <div><h1 class="text-4xl font-bold">Pagina non trovata</h1><p class="mt-3">Questa pagina del portfolio non esiste.</p><a class="inline-block mt-6 underline" href="/portfolio">Torna al portfolio</a></div>
    </section>
  ) : (
  <div class="c3 c3p">
    <C3PageHero
      kicker="Lavori"
      title={`Portfolio — pagina ${currentPage}`}
      accent="Portfolio"
      size="l"
      lead="Archivio dei progetti con lo stato dichiarato su ogni scheda."
      actions={[{ text: '← Torna ai progetti in evidenza', href: '/portfolio', variant: 'secondary' }]}
    />
    <C3Archive items={items} counts={counts} currentPage={currentPage} totalPages={totalPages} />
    <C3Paths />
  </div>
  )}
</Layout>
