---
import Layout from "@/layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";

const CTA_HREF = "/contatti?servizio=audit-rapido";

const situations = [
  "Il sito è lento a caricare.",
  "Da telefono si usa male.",
  "Ci sono errori o pagine che non funzionano.",
  "Non si capisce subito cosa offri.",
  "Su Google alcune pagine non si trovano.",
  "Arrivano visite, ma non richieste.",
];

const auditAreas = [
  {
    icon: "tabler:gauge",
    title: "Prestazioni",
    description: "Quanto è veloce il sito e cosa lo appesantisce.",
    checks:
      "Tempi di caricamento · immagini pesanti · risorse che bloccano la pagina",
  },
  {
    icon: "tabler:device-mobile",
    title: "Mobile e responsive",
    description:
      "Come si comporta sullo schermo da cui arriva la maggior parte delle persone.",
    checks:
      "Leggibilità · menu · pulsanti troppo piccoli · elementi fuori schermo",
  },
  {
    icon: "tabler:accessible",
    title: "UX e accessibilità",
    description:
      "Se il percorso verso il contatto è chiaro e usabile da tutti.",
    checks:
      "Posizione delle CTA · attrito nei form · contrasti · uso da tastiera",
  },
  {
    icon: "tabler:search",
    title: "SEO tecnica",
    description: "Se le pagine sono leggibili dai motori di ricerca.",
    checks:
      "Titoli e descrizioni · indicizzazione · link rotti · contenuti duplicati",
  },
  {
    icon: "tabler:layout-list",
    title: "Contenuti e gerarchie",
    description: "Se si capisce cosa fai, per chi e cosa deve fare chi arriva.",
    checks:
      "Chiarezza del messaggio · ordine delle informazioni · pagine doppie o inutili",
  },
  {
    icon: "tabler:shield-check",
    title: "Sicurezza e manutenzione visibile",
    description: "Quello che si può verificare dall’esterno, senza accessi.",
    checks:
      "Certificato HTTPS · avvisi del browser · componenti visibilmente non aggiornati",
  },
];

const deliverables = [
  {
    title: "Un report comprensibile",
    description:
      "In italiano semplice, con gli screenshot di ciò che ho trovato. Ogni problema è spiegato, non solo elencato.",
  },
  {
    title: "I problemi ordinati per priorità",
    description:
      "Non un elenco infinito: prima quello che pesa davvero sui risultati.",
  },
  {
    title: "Indicazioni operative",
    description:
      "Cosa fare per ogni problema, in modo che sia utilizzabile anche dal tuo tecnico.",
  },
  {
    title: "Cosa è urgente e cosa può aspettare",
    description:
      "Tre livelli dichiarati, così decidi con ordine e senza sorprese.",
  },
];

const processSteps = [
  {
    title: "Mi invii il sito",
    description: "L’indirizzo e due righe sul problema che noti.",
  },
  {
    title: "Confermo il perimetro",
    description:
      "Verifico quante pagine sono e ti confermo prezzo e tempi. Poi si parte.",
  },
  {
    title: "Analizzo il sito",
    description:
      "Controlli tecnici più verifica manuale, con screenshot di ogni problema.",
  },
  {
    title: "Ricevi il report",
    description:
      "Entro 7 giorni lavorativi dalla conferma. Le correzioni, se le vuoi, sono un lavoro separato.",
  },
];

const reportExamples = [
  {
    number: "01",
    priority: "Urgente",
    priorityClass:
      "border-red-200 bg-red-50 text-red-700 dark:border-red-400/30 dark:bg-red-950/30 dark:text-red-300",
    icon: "▲",
    title: "Da telefono non si capisce dove chiedere un preventivo",
    why: "Il pulsante di contatto ha lo stesso peso di altre tre azioni vicine, quindi l’utente non sa cosa toccare.",
    action:
      "Una sola azione principale ben visibile, le altre come link. Intervento breve.",
  },
  {
    number: "02",
    priority: "Importante",
    priorityClass:
      "border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-400/30 dark:bg-amber-950/30 dark:text-amber-300",
    icon: "◆",
    title: "Tre pagine hanno lo stesso titolo su Google",
    why: "Le pagine si somigliano troppo e chi cerca non capisce quale aprire.",
    action: "Riscrivere titolo e descrizione di ogni pagina, una per servizio.",
  },
  {
    number: "03",
    priority: "Migliorativo",
    priorityClass:
      "border-slate-200 bg-slate-50 text-slate-600 dark:border-slate-500/30 dark:bg-slate-800/50 dark:text-slate-300",
    icon: "●",
    title: "Due link nel footer portano a pagine che non esistono più",
    why: "Dà un’impressione di sito abbandonato, anche se il resto funziona.",
    action: "Aggiornare i due indirizzi. Pochi minuti di lavoro.",
  },
];

const included = [
  "Analisi delle sei aree, tecnica e manuale",
  "Report PDF con evidenze e screenshot",
  "Problemi ordinati per priorità",
  "Indicazioni operative su cosa correggere",
  "Indicazione su cosa conviene correggere e cosa rifare",
];

const excluded = [
  "L’esecuzione delle correzioni",
  "Restyling o rifacimento del sito",
  "La call finale di presentazione",
  "Garanzie su posizionamento, traffico o vendite",
  "Aree riservate, gestionali e pagine protette",
];

const faqItems = [
  {
    question: "Devo rifare il sito?",
    answer:
      "Spesso no. Molti problemi si correggono senza ricostruire tutto: l’audit serve a capire quali e a dirti con quale ordine affrontarli.",
  },
  {
    question: "Le correzioni sono incluse?",
    answer:
      "No. L’audit è la diagnosi: ti dico cosa non funziona e cosa fare. Se vuoi che intervenga io, lo preventivo separatamente.",
  },
  {
    question: "Cosa devi darmi per iniziare?",
    answer:
      "L’indirizzo del sito e una breve descrizione del problema che noti. Non mi serve l’accesso al pannello: analizzo il sito pubblico.",
  },
  {
    question: "Funziona con WordPress e con altre piattaforme?",
    answer: "Sì. Cambiano le indicazioni tecniche, non il metodo di analisi.",
  },
  {
    question: "In quanto tempo ricevo il report?",
    answer: "Entro 7 giorni lavorativi dalla conferma del perimetro.",
  },
  {
    question: "Mi garantisci più visite o più clienti?",
    answer:
      "No, e chi lo garantisce sta semplificando. Ti dico cosa non funziona, perché conta e cosa conviene fare: la decisione resta tua.",
  },
];

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Audit del sito",
  description:
    "Audit del sito pubblico su UX, SEO tecnica, performance e accessibilità: prestazioni, mobile, contenuti e sicurezza visibile.",
  url: "https://www.lswebagency.com/servizi/audit-rapido",
  provider: {
    "@type": "Organization",
    name: "LS Web Agency",
    url: "https://www.lswebagency.com",
  },
  areaServed: "IT",
  offers: {
    "@type": "Offer",
    price: "349",
    priceCurrency: "EUR",
    availability: "https://schema.org/InStock",
    url: "https://www.lswebagency.com/contatti?servizio=audit-rapido",
  },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const metadata = {
  title: "Audit del sito: UX, SEO tecnica, performance e accessibilità | LS Web Agency",
  description:
    "Scopri perché il tuo sito non porta richieste. Audit del sito fino a 10 pagine su UX, SEO tecnica, performance e accessibilità, report PDF con priorità e indicazioni operative a 349 €.",
  canonical: "/servizi/audit-rapido",
  robots: { index: true, follow: true },
  openGraph: {
    url: "/servizi/audit-rapido",
    type: "website",
  },
  jsonLd: [serviceJsonLd, faqJsonLd],
};
---

<Layout metadata={metadata}>
  <!-- 1. HERO -->
  <section
    class="ls-rescue-hero relative isolate overflow-hidden border-b border-neutral-200 text-neutral-950 dark:border-white/10 dark:text-white"
  >
    <div class="ls-rescue-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div
      class="container mx-auto px-6 pb-16 pt-14 md:pb-20 md:pt-16 lg:pb-24 lg:pt-20"
    >
      <div
        class="grid items-center gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:gap-16"
      >
        <div>
          <div
            class="flex flex-wrap items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.18em] text-violet-700 dark:text-violet-200"
          >
            <span
              class="inline-flex items-center gap-2 border border-neutral-200 px-3 py-2 dark:border-white/20"
            >
              <span class="h-2 w-2 bg-gradient-to-br from-primary to-[#E72AAE]"
              ></span>
              Audit del sito
            </span>
            <span>UX, SEO tecnica, performance e accessibilità</span>
          </div>

          <h1
            class="mt-7 max-w-3xl text-4xl font-extrabold leading-[1.04] tracking-tight sm:text-5xl lg:text-6xl"
          >
            Il tuo sito non porta richieste? Scopriamo perché.
          </h1>

          <p
            class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-slate-300"
          >
            Analizzo il sito, individuo i problemi reali e li metto in ordine di
            priorità. Spesso non serve rifarlo da zero: serve sapere da dove
            partire.
          </p>

          <dl
            class="mt-8 grid max-w-2xl gap-5 border-y border-neutral-200 py-5 dark:border-white/15 sm:grid-cols-3"
          >
            <div>
              <dt
                class="text-xs uppercase tracking-wide text-neutral-500 dark:text-slate-400"
              >
                Prezzo
              </dt>
              <dd class="mt-1 text-2xl font-extrabold">349 €</dd>
              <dd class="text-sm text-neutral-500 dark:text-slate-400">
                IVA non applicata
              </dd>
            </div>
            <div>
              <dt
                class="text-xs uppercase tracking-wide text-neutral-500 dark:text-slate-400"
              >
                Perimetro
              </dt>
              <dd class="mt-1 font-bold">Fino a 10 pagine</dd>
              <dd class="text-sm text-neutral-500 dark:text-slate-400">
                Sito pubblico
              </dd>
            </div>
            <div>
              <dt
                class="text-xs uppercase tracking-wide text-neutral-500 dark:text-slate-400"
              >
                Consegna
              </dt>
              <dd class="mt-1 font-bold">7 giorni lavorativi</dd>
              <dd class="text-sm text-neutral-500 dark:text-slate-400">
                Dalla conferma
              </dd>
            </div>
          </dl>

          <div
            class="mt-8 flex flex-col items-stretch gap-4 sm:flex-row sm:items-center"
          >
            <a href={CTA_HREF} class="btn-primary w-full px-7 sm:w-auto">
              Richiedi l’audit del sito
              <Icon
                name="tabler:arrow-right"
                class="h-5 w-5"
                aria-hidden="true"
              />
            </a>
            <a
              href="#esempio-report"
              class="btn btn-tertiary self-start text-violet-700 dark:text-violet-200"
            >
              Vedi un esempio di report
            </a>
          </div>

          <p class="mt-5 text-sm text-neutral-500 dark:text-slate-400">
            Prima verifico il perimetro. Nessun pagamento immediato.
          </p>
        </div>

        <div
          class="ls-diagnostic-panel relative border border-white/20 bg-[#0f172a] p-5 text-white shadow-2xl shadow-fuchsia-950/20 sm:p-7"
          role="img"
          aria-label="Esempio dimostrativo di analisi con problemi di prestazioni, mobile e SEO ordinati per priorità"
        >
          <div
            class="flex items-center justify-between gap-4 border-b border-white/15 pb-4"
          >
            <div class="flex min-w-0 items-center gap-3 text-sm text-slate-400">
              <span class="flex gap-1" aria-hidden="true">
                <span class="h-2 w-2 bg-slate-500"></span>
                <span class="h-2 w-2 bg-slate-600"></span>
              </span>
              <span class="truncate">https://iltuosito.it</span>
            </div>
            <span
              class="shrink-0 border border-fuchsia-500/60 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-[0.14em] text-fuchsia-200"
            >
              In analisi
            </span>
          </div>

          <div class="divide-y divide-white/10">
            <div class="py-5">
              <div class="flex items-start justify-between gap-5">
                <div>
                  <p
                    class="text-xs font-bold uppercase tracking-[0.15em] text-white"
                  >
                    Prestazioni
                  </p>
                  <p class="mt-2 text-sm text-slate-400">
                    Immagini pesanti, caricamento lento
                  </p>
                  <p
                    class="mt-2 text-xs font-bold uppercase tracking-wide text-red-300"
                  >
                    ▲ Urgente
                  </p>
                </div>
                <span
                  class="mt-2 h-7 w-20 border border-fuchsia-500/60 bg-fuchsia-500/10"
                  aria-hidden="true"></span>
              </div>
            </div>
            <div class="py-5">
              <div class="flex items-start justify-between gap-5">
                <div>
                  <p
                    class="text-xs font-bold uppercase tracking-[0.15em] text-white"
                  >
                    Mobile
                  </p>
                  <p class="mt-2 text-sm text-slate-400">
                    CTA poco riconoscibile
                  </p>
                  <p
                    class="mt-2 text-xs font-bold uppercase tracking-wide text-red-300"
                  >
                    ▲ Urgente
                  </p>
                </div>
                <span
                  class="mt-2 h-7 w-20 border border-fuchsia-500/60 bg-fuchsia-500/10"
                  aria-hidden="true"></span>
              </div>
            </div>
            <div class="py-5">
              <div class="flex items-start justify-between gap-5">
                <div>
                  <p
                    class="text-xs font-bold uppercase tracking-[0.15em] text-white"
                  >
                    SEO
                  </p>
                  <p class="mt-2 text-sm text-slate-400">
                    Titoli duplicati su tre pagine
                  </p>
                  <p
                    class="mt-2 text-xs font-bold uppercase tracking-wide text-amber-300"
                  >
                    ◆ Importante
                  </p>
                </div>
                <span
                  class="mt-2 h-7 w-20 border border-violet-500/60 bg-violet-500/10"
                  aria-hidden="true"></span>
              </div>
            </div>
          </div>

          <div
            class="flex flex-col gap-2 border-t border-white/15 pt-4 text-xs text-slate-400 sm:flex-row sm:justify-between"
          >
            <span
              >Le barre indicano il livello di priorità, non un punteggio.</span
            >
            <span class="shrink-0">Esempio dimostrativo</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. QUANDO SERVE -->
  <section class="container mx-auto px-6 py-16 md:py-20">
    <div class="grid gap-7 lg:grid-cols-2 lg:items-end">
      <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">
        Quando serve un audit
      </h2>
      <p
        class="max-w-xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300"
      >
        Se riconosci una di queste situazioni, l’analisi ti fa risparmiare tempo
        e soldi: eviti di rifare parti che funzionano.
      </p>
    </div>

    <ul
      class="mt-10 grid gap-px overflow-hidden border border-neutral-200 bg-neutral-200 sm:grid-cols-2 lg:grid-cols-3 dark:border-neutral-800 dark:bg-neutral-800"
    >
      {
        situations.map((situation) => (
          <li class="flex min-h-28 items-center gap-3 bg-white p-6 font-semibold dark:bg-slate-950">
            <span
              class="h-0.5 w-5 shrink-0 bg-gradient-to-r from-primary to-[#E72AAE]"
              aria-hidden="true"
            />
            <span>{situation}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 3. COSA ANALIZZO -->
  <section class="bg-brand-surface/75 dark:bg-violet-950/15">
    <div class="container mx-auto px-6 py-16 md:py-20">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">
          Cosa analizzo
        </h2>
        <p
          class="mt-4 text-lg leading-relaxed text-neutral-600 dark:text-neutral-300"
        >
          Sei aree, con controlli concreti su ciascuna. Analisi del sito
          pubblico fino a 10 pagine: aree riservate e gestionali sono escluse.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          auditAreas.map((area) => (
            <article class="border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-800 dark:bg-slate-950">
              <Icon
                name={area.icon}
                class="h-8 w-8 text-primary dark:text-violet-300"
                aria-hidden="true"
              />
              <h3 class="mt-5 text-xl font-bold">{area.title}</h3>
              <p class="mt-2 leading-relaxed text-neutral-600 dark:text-neutral-300">
                {area.description}
              </p>
              <p class="mt-5 border-t border-neutral-200 pt-4 text-sm leading-relaxed text-neutral-500 dark:border-neutral-800 dark:text-neutral-400">
                {area.checks}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. COSA RICEVI -->
  <section id="cosa-ricevi" class="scroll-mt-24">
    <div class="container mx-auto px-6 py-16 md:py-20">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">
            Cosa ricevi
          </h2>
          <p
            class="mt-4 max-w-lg text-lg leading-relaxed text-neutral-600 dark:text-neutral-300"
          >
            Un documento che puoi leggere tu e usare con chi farà le correzioni,
            anche se non sono io.
          </p>
          <div class="mt-8 flex flex-wrap gap-2">
            {
              [
                "PDF via email",
                "Entro 7 giorni lavorativi",
                "Il report è tuo",
              ].map((item) => (
                <span class="border border-violet-200 bg-brand-surface px-3 py-2 text-sm font-semibold text-neutral-700 dark:border-violet-500/30 dark:bg-violet-950/30 dark:text-violet-200">
                  {item}
                </span>
              ))
            }
          </div>
        </div>

        <ol
          class="divide-y divide-neutral-200 border-y border-neutral-200 dark:divide-neutral-800 dark:border-neutral-800"
        >
          {
            deliverables.map((item, index) => (
              <li class="grid gap-3 py-5 sm:grid-cols-[3.25rem_1fr]">
                <span class="text-sm font-extrabold text-primary dark:text-violet-300">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3 class="font-bold">{item.title}</h3>
                  <p class="mt-1 leading-relaxed text-neutral-600 dark:text-neutral-300">
                    {item.description}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 5. COME FUNZIONA -->
  <section class="bg-brand-surface/75 dark:bg-violet-950/15">
    <div class="container mx-auto px-6 py-16 md:py-20">
      <div class="grid gap-5 lg:grid-cols-2 lg:items-end">
        <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">
          Come funziona
        </h2>
        <p class="text-lg text-neutral-600 dark:text-neutral-300">
          Quattro passi. Il prezzo e i tempi vengono confermati prima di
          iniziare.
        </p>
      </div>

      <ol
        class="relative mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4 lg:gap-0"
      >
        {
          processSteps.map((step, index) => (
            <li class="relative border-l border-violet-300 pl-6 lg:border-l-0 lg:border-t lg:px-6 lg:pt-7 dark:border-violet-700">
              <span
                class="absolute -left-[0.32rem] top-1 h-2.5 w-2.5 bg-primary lg:-top-[0.32rem] lg:left-6"
                aria-hidden="true"
              />
              <span class="text-sm font-bold text-primary dark:text-violet-300">
                Passo {index + 1}
              </span>
              <h3 class="mt-2 text-lg font-bold">{step.title}</h3>
              <p class="mt-2 leading-relaxed text-neutral-600 dark:text-neutral-300">
                {step.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. ESEMPIO REPORT -->
  <section
    id="esempio-report"
    class="ls-report-section scroll-mt-24 border-t-4 border-t-primary text-white"
  >
    <div class="container mx-auto px-6 py-16 md:py-20">
      <div class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">
            Un esempio di report
          </h2>
          <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-300">
            Ogni problema è una scheda: cosa succede, perché conta per te, cosa
            farei. Niente punteggi, niente grafici inutili.
          </p>
        </div>
        <p class="text-sm font-semibold text-slate-400">
          Esempio dimostrativo. I valori non rappresentano dati reali.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          reportExamples.map((item) => (
            <article class="flex h-full flex-col bg-white p-6 text-neutral-900 dark:bg-slate-100">
              <div class="flex items-center justify-between gap-4">
                <span class="text-xs font-extrabold uppercase tracking-[0.14em] text-[#E72AAE]">
                  Problema {item.number}
                </span>
                <span
                  class:list={[
                    "border px-3 py-1 text-[0.68rem] font-bold uppercase tracking-[0.08em]",
                    item.priorityClass,
                  ]}
                >
                  {item.icon} {item.priority}
                </span>
              </div>
              <h3 class="mt-6 text-xl font-bold leading-snug">{item.title}</h3>
              <div class="mt-6 border-t border-neutral-200 pt-5 text-neutral-600">
                <p class="leading-relaxed">
                  <strong class="text-neutral-900">Perché conta:</strong>{" "}
                  {item.why}
                </p>
                <p class="mt-4 leading-relaxed">
                  <strong class="text-neutral-900">Cosa farei:</strong>{" "}
                  {item.action}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 7. PREZZO -->
  <section id="prezzi" class="scroll-mt-24">
