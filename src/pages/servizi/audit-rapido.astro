  <style>
    .ls-rescue-hero {
      background:
        radial-gradient(
          circle at 85% 20%,
          rgb(231 42 174 / 0.07),
          transparent 32%
        ),
        radial-gradient(
          circle at 15% 90%,
          rgb(118 40 232 / 0.09),
          transparent 38%
        ),
        #ffffff;
    }

    :global(.dark) .ls-rescue-hero {
      background:
        radial-gradient(
          circle at 85% 20%,
          rgb(231 42 174 / 0.13),
          transparent 32%
        ),
        radial-gradient(
          circle at 15% 90%,
          rgb(118 40 232 / 0.22),
          transparent 38%
        ),
        #0f172a;
    }

    .ls-report-section {
      background:
        radial-gradient(
          circle at 85% 20%,
          rgb(231 42 174 / 0.13),
          transparent 32%
        ),
        radial-gradient(
          circle at 15% 90%,
          rgb(118 40 232 / 0.22),
          transparent 38%
        ),
        #0f172a;
    }

    .ls-rescue-grid {
      opacity: 0.36;
      background-image:
        linear-gradient(rgb(148 163 184 / 0.11) 1px, transparent 1px),
        linear-gradient(90deg, rgb(148 163 184 / 0.11) 1px, transparent 1px);
      background-size: 96px 96px;
      mask-image: linear-gradient(to bottom, black, transparent 96%);
    }

    .ls-diagnostic-panel {
      isolation: isolate;
    }

    .ls-diagnostic-panel::before {
      position: absolute;
      inset: -12% 10% auto 24%;
      z-index: -1;
      height: 72%;
      border: 1px solid rgb(231 42 174 / 0.22);
      content: "";
      transform: skewX(-12deg);
    }

    .ls-diagnostic-panel::after {
      position: absolute;
      inset-inline: 0;
      top: 38%;
      height: 2px;
      background: linear-gradient(
        90deg,
        transparent,
        rgb(231 42 174 / 0.65),
        transparent
      );
      box-shadow: 0 0 22px 7px rgb(231 42 174 / 0.16);
      content: "";
      animation: rescue-scan 6s ease-in-out infinite;
      pointer-events: none;
    }

    @keyframes rescue-scan {
      0%,
      100% {
        opacity: 0;
        transform: translateY(-80px);
      }
      25%,
      70% {
        opacity: 1;
      }
      85% {
        opacity: 0;
        transform: translateY(170px);
      }
    }

    @media (max-width: 639px) {
      .ls-rescue-grid {
        background-size: 64px 64px;
      }

      .ls-diagnostic-panel::before,
      .ls-diagnostic-panel::after {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .ls-diagnostic-panel::after {
        animation: none;
      }
    }
  </style>
</Layout>
