---
import Layout from '@/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import C3PageHero from '@/components/c3/page/C3PageHero.astro';
import C3Section from '@/components/c3/page/C3Section.astro';

const metadata = {
  title: 'Realizzazione siti web professionali per PMI | LS Web Agency',
  description:
    "Progetto siti web professionali per PMI e professionisti: struttura chiara, form, SEO e tracciamento integrati fin dall'inizio, non aggiunti dopo.",
  canonical: '/servizi/siti-web',
  robots: { index: true, follow: true },
};

const WHATSAPP = 'https://wa.me/393403223494?text=Ciao%2C%20vorrei%20informazioni%20su%20un%20sito%20web%20strategico.';

const FEATURES = [
        {
          icon: 'tabler:layout',
          title: 'Struttura orientata alle richieste',
          desc: 'Pagine e percorsi pensati per guidare il visitatore verso un contatto: messaggio chiaro, priorità visive e nessun passaggio superfluo.',
        },
        {
          icon: 'tabler:target-arrow',
          title: 'Form e CTA più chiari',
          desc: 'Moduli semplici, WhatsApp e call to action visibili: l’utente capisce subito come richiedere informazioni o un preventivo.',
        },
        {
          icon: 'tabler:mail',
          title: 'Gestione ordinata dei contatti',
          desc: 'Le richieste arrivano in modo strutturato, con i dati utili per rispondere in tempi brevi e senza perdere lead.',
        },
        {
          icon: 'tabler:search',
          title: 'SEO tecnica e contenuti essenziali',
          desc: 'Base tecnica solida, meta tag, struttura leggibile e testi mirati per farti trovare dalle ricerche che contano.',
        },
        {
          icon: 'tabler:chart-line',
          title: 'Tracciamento e automazioni leggere',
          desc: 'Monitoraggio delle conversioni e piccoli flussi automatici — notifiche, reminder, risposte iniziali — integrati nel sito.',
        },
      ];
const REASONS = [
  {
    "title": "Progetto orientato alle richieste",
    "desc": "Parto da come arrivano i contatti oggi e da come vuoi gestirli domani. Ogni scelta — struttura, contenuti, form — serve a generare e qualificare richieste, non a riempire pagine."
  },
  {
    "title": "Percorso utente chiaro",
    "desc": "Messaggio, gerarchia visiva e CTA pensati per ridurre attriti: il visitatore capisce subito cosa offri e come contattarti, da qualsiasi dispositivo."
  },
  {
    "title": "Contatti gestiti con ordine",
    "desc": "Form strutturati, notifiche e flusso di risposta definiti fin dall’inizio: le richieste non restano disperse tra email, WhatsApp e moduli scollegati."
  },
  {
    "title": "Misurazione e crescita modulare",
    "desc": "Tracciamento delle conversioni integrato e base solida da cui partire: puoi aggiungere SEO, automazioni o nuove sezioni nel tempo, senza rifare il sito da zero."
  }
];
---

<Layout metadata={metadata} headerTone="dark">
  <div class="c3 c3p c4-service-detail">
    <C3PageHero
      kicker="Siti web strategici"
      title="Siti web strategici per acquisire e gestire richieste clienti"
      accent="per acquisire e gestire richieste clienti"
      size="l"
      lead="Progetto siti web su misura che aiutano le persone a comprendere la tua offerta e a contattarti. Struttura, contenuti, interfaccia, SEO e misurazione sono pensati insieme, fin dall’inizio."
      actions={[
        { text: 'Richiedi preventivo sito', href: '/contatti?servizio=siti-web' },
        { text: 'WhatsApp', href: WHATSAPP, variant: 'secondary', external: true },
      ]}
    >
      <p class="c4-service-local">
        Se la tua attività ha sede a Sassari, trovi tipologie di progetto e indicazioni sui preventivi nella pagina dedicata alla
        <a href="/servizi/creazione-siti-web-sassari">creazione di siti web a Sassari</a>.
      </p>
      <div slot="aside" class="c4-service-aside">
        <figure class="c4-service-visual">
          <img src="/images/creazione-sito-web-professionale.webp" alt="Sito web strategico orientato ad acquisire e gestire richieste clienti" width="800" height="600" loading="eager" decoding="async" />
        </figure>
        <ul class="c4-service-tags" aria-label="Caratteristiche">
          <li>Richieste clienti</li><li>Form &amp; CTA</li><li>SEO &amp; tracking</li>
        </ul>
      </div>
    </C3PageHero>

    <C3Section tone="ivory" id="cosa-include" index="01" kicker="Il progetto" title="Cosa include un sito web strategico" lead="Form, SEO, tracciamento e gestione richieste fanno parte del sito — non servizi separati da aggiungere in un secondo momento.">
      <div class="c4-service-features">
        {FEATURES.map((item, i) => (
          <article class="c4-service-feature">
            <div class="c4-service-feature-top">
              <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <Icon name={item.icon} class="c4-service-icon" aria-hidden="true" />
            </div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </C3Section>

    <C3Section tone="deep" id="perche-sceglierci" index="02" kicker="Metodo" title="Perché scegliere LS Web Agency">
      <div class="c4-service-reasons">
        {REASONS.map((item, i) => (
          <article class="c4-service-reason">
            <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{item.title}</h3><p>{item.desc}</p></div>
          </article>
        ))}
      </div>
    </C3Section>

    <C3Section tone="ivory" id="progetto" index="03" kicker="Contatti" title="Parliamo del tuo progetto web" lead="Raccontami obiettivi, tipologia di clienti e come gestisci oggi i contatti: valuto il progetto e preparo una proposta di sito strategico su misura.">
      <div class="c4-service-actions">
        <a class="c3-btn c3-btn--p" href="/contatti?servizio=siti-web">Richiedi preventivo sito <Icon name="tabler:arrow-right" class="c3-ico" aria-hidden="true" /></a>
        <a class="c3-btn c3-btn--s" href={WHATSAPP} target="_blank" rel="noopener noreferrer"><Icon name="tabler:brand-whatsapp" class="c3-ico" aria-hidden="true" /> Scrivimi su WhatsApp</a>
      </div>
    </C3Section>
  </div>
</Layout>
