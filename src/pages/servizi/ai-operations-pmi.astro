---
import Layout from '@/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Automazione processi con AI per PMI | LS Web Agency',
  description:
    'Automazione dei processi per PMI: colleghiamo sito, email, CRM, calendario e sistemi AI con monitoraggio, controllo umano e risultati misurabili.',
  canonical: '/servizi/ai-operations-pmi',
  ignoreTitleTemplate: true,
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Automazione dei processi con AI per PMI',
  alternateName: 'AI Operations per PMI',
  description:
    'Analisi, progettazione e monitoraggio di workflow operativi per PMI: lead, CRM, email, calendario, documenti, follow-up e controllo umano.',
  provider: {
    '@type': 'ProfessionalService',
    name: 'LS Web Agency',
    url: 'https://www.lswebagency.com/',
  },
  areaServed: 'IT',
  serviceType: 'Automazione processi aziendali con AI',
  url: 'https://www.lswebagency.com/servizi/ai-operations-pmi',
};

const fitSignals = [
  'Il processo si ripete abbastanza spesso da poterlo misurare',
  'Esiste già un punto di ingresso digitale: form, email, CRM, gestionale o database',
  'Le eccezioni principali sono note o possono essere raccolte',
  'C’è un referente interno che conosce davvero il processo',
  'Possiamo misurare tempo, errori, tempi di risposta o altri KPI prima e dopo',
];

const noFitSignals = [
  'Il processo cambia ogni volta e vive solo nella memoria di una persona',
  'I dati sono duplicati, incompleti o privi di una fonte affidabile',
  'L’automazione dovrebbe prendere subito decisioni sensibili o irreversibili',
  'Il volume è troppo basso per giustificare costo e manutenzione',
];

const benefits = [
  {
    icon: 'tabler:route',
    title: 'Richieste instradate con ordine',
    text: 'Form, email e altri canali possono confluire in un flusso unico, con dati normalizzati e priorità esplicite.',
  },
  {
    icon: 'tabler:user-check',
    title: 'Lead preparati per il commerciale',
    text: 'L’AI può interpretare testo libero e documenti; regole verificabili decidono poi dove registrare o inoltrare i dati.',
  },
  {
    icon: 'tabler:database',
    title: 'CRM e sistemi allineati',
    text: 'Riduciamo copia-incolla, duplicati e passaggi manuali tra sito, inbox, CRM, calendario e database.',
  },
  {
    icon: 'tabler:mail-forward',
    title: 'Follow-up senza dimenticanze',
    text: 'Promemoria, bozze e attività successive partono secondo regole definite e con escalation quando qualcosa non torna.',
  },
  {
    icon: 'tabler:shield-check',
    title: 'Controllo sulle azioni',
    text: 'I permessi vengono limitati al necessario. Le azioni più rischiose restano in bozza o richiedono approvazione.',
  },
  {
    icon: 'tabler:calendar-event',
    title: 'Monitoraggio dopo il go-live',
    text: 'Non consegniamo un workflow e spariamo: errori, fallback e integrazioni devono essere osservabili anche dopo il rilascio.',
  },
];

const autonomyLevels = [
  ['0', 'Osserva', 'Legge, cerca, classifica o sintetizza senza modificare dati.'],
  ['1', 'Prepara', 'Crea bozze, proposte e dati strutturati che una persona può verificare.'],
  ['2', 'Propone', 'Prepara un’azione reale, ma l’esecuzione richiede approvazione esplicita.'],
  ['3', 'Esegue', 'Solo per azioni a basso rischio, reversibili, ben testate e monitorate.'],
];

const reliabilityItems = [
  ['Retry e fallback', 'Se un’API non risponde o un dato è ambiguo, il flusso non deve fingere che tutto sia andato bene.'],
  ['Deduplica e idempotenza', 'Evitiamo che un retry crei due lead, due appuntamenti o due invii.'],
  ['Alert operativi', 'Gli errori importanti devono arrivare a una persona prima che il cliente scopra il problema.'],
  ['Audit trail', 'Registriamo cosa è successo, quale passaggio ha agito e quando è intervenuta una persona.'],
  ['Minimo privilegio', 'Ogni integrazione riceve soltanto i permessi necessari al proprio compito.'],
  ['Documentazione e uscita', 'Credenziali, mappa delle integrazioni e procedure restano comprensibili e trasferibili.'],
];

const phases = [
  ['Fit Check', 'Mappiamo un processo, dati, volumi, integrazioni, eccezioni, rischi e KPI. Esito: GO, PREPARARE o NO-GO.'],
  ['Pilot', 'Costruiamo un solo workflow prioritario e lo testiamo con casi reali o simulati prima della produzione.'],
  ['Go-live controllato', 'Partiamo con il livello di autonomia più basso compatibile con il risultato e aumentiamo solo con evidenze.'],
  ['Misurazione', 'Confrontiamo baseline e risultati: tempo, successo del workflow, fallback, errori e costo operativo.'],
  ['Operations Care', 'Monitoriamo salute del flusso, API, consumi e piccoli cambiamenti che potrebbero romperlo nel tempo.'],
];
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- HERO -->
  <section class="relative isolate overflow-hidden">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-b from-violet-100 via-white to-white dark:from-violet-950/45 dark:via-neutral-950 dark:to-neutral-950"></div>
    <div aria-hidden="true" class="absolute -top-28 left-1/2 -z-10 h-72 w-72 -translate-x-1/2 rounded-full bg-fuchsia-300/30 blur-3xl dark:bg-fuchsia-600/10"></div>

    <div class="container mx-auto max-w-6xl px-6 pt-16 pb-14 md:pt-24 md:pb-20">
      <div class="mx-auto max-w-4xl text-center">
        <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white/70 px-4 py-2 text-sm font-semibold text-violet-700 shadow-sm dark:border-violet-800 dark:bg-neutral-900/70 dark:text-violet-300">
          <Icon name="tabler:automation" class="h-4 w-4" />
          Automazione processi · AI Operations
        </p>

        <h1 class="text-4xl font-extrabold tracking-tight text-neutral-950 md:text-6xl dark:text-white">
          Meno passaggi manuali. <span class="text-violet-700 dark:text-violet-400">Processi sotto controllo.</span>
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-neutral-600 md:text-xl dark:text-neutral-300">
          Colleghiamo sito, email, CRM, calendario e altri strumenti per ridurre attività ripetitive e richieste perse. L’AI viene usata dove serve a interpretare input non strutturati; le azioni prevedibili restano affidate a regole verificabili.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/process-fit-check" class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-violet-600 px-6 py-3 font-semibold text-white transition hover:bg-violet-700 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2">
            Verifica se il processo è automatizzabile
          </a>
          <a href="#metodo" class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-neutral-300 bg-white/70 px-6 py-3 font-semibold text-neutral-900 transition hover:bg-white dark:border-neutral-700 dark:bg-neutral-900/60 dark:text-white dark:hover:bg-neutral-900">
            Vedi il metodo
          </a>
        </div>

        <p class="mt-6 text-sm text-neutral-500 dark:text-neutral-400">
          Pensato soprattutto per PMI già sufficientemente digitalizzate · un processo alla volta · monitoraggio dopo il go-live
        </p>
      </div>
    </div>
  </section>

  <!-- FIT -->
  <section class="container mx-auto max-w-6xl px-6 py-14 md:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-violet-700 dark:text-violet-400">Prima domanda: conviene davvero?</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">Non automatizziamo un processo solo perché è possibile.</h2>
      <p class="mt-5 text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">
        Un’automazione sopra dati disordinati o responsabilità poco chiare rende il problema più veloce, non migliore. Per questo il progetto parte da un Process Fit Check e può concludersi anche con un NO-GO.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <article class="rounded-3xl border border-emerald-200 bg-emerald-50/60 p-6 md:p-8 dark:border-emerald-900 dark:bg-emerald-950/20">
        <h3 class="text-xl font-bold">Buoni segnali</h3>
        <ul class="mt-5 space-y-3 text-neutral-700 dark:text-neutral-300">
          {fitSignals.map((item) => (
            <li class="flex gap-3"><Icon name="tabler:circle-check" class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" /><span>{item}</span></li>
          ))}
        </ul>
      </article>

      <article class="rounded-3xl border border-amber-200 bg-amber-50/60 p-6 md:p-8 dark:border-amber-900 dark:bg-amber-950/20">
        <h3 class="text-xl font-bold">Prima va sistemato il processo</h3>
        <ul class="mt-5 space-y-3 text-neutral-700 dark:text-neutral-300">
          {noFitSignals.map((item) => (
            <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-amber-500"></span><span>{item}</span></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <!-- PRINCIPIO -->
  <section class="border-y border-neutral-200 bg-neutral-50/70 dark:border-neutral-800 dark:bg-neutral-900/25">
    <div class="container mx-auto max-w-6xl px-6 py-14 md:py-20">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-violet-700 dark:text-violet-400">Principio tecnico</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">L’AI interpreta. Il software esegue.</h2>
          <p class="mt-5 text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">
            Se una regola può essere scritta in modo chiaro, non serve affidarla a un agente. Usiamo i modelli AI soprattutto per comprendere email, richieste, documenti e testo libero; validazioni, routing e azioni operative restano deterministiche quando possibile.
          </p>
        </div>

        <div class="rounded-3xl border border-neutral-200 bg-white p-6 shadow-sm md:p-8 dark:border-neutral-800 dark:bg-neutral-900/60">
          <div class="space-y-4">
            {[
              ['1', 'Ingresso', 'Email, form, documento o altro evento'],
              ['2', 'Interpretazione', 'AI solo dove l’input è ambiguo o non strutturato'],
              ['3', 'Validazione', 'Regole, campi obbligatori, duplicati e vincoli'],
              ['4', 'Azione', 'CRM, calendario, notifica, bozza o attività'],
              ['5', 'Controllo', 'Log, alert, fallback e approvazione quando richiesta'],
            ].map(([n, title, text]) => (
              <div class="flex gap-4 rounded-2xl bg-neutral-50 p-4 dark:bg-neutral-950/50">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-violet-600 text-sm font-bold text-white">{n}</span>
                <div>
                  <h3 class="font-semibold text-neutral-900 dark:text-white">{title}</h3>
                  <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-300">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFICI -->
  <section class="container mx-auto max-w-6xl px-6 py-14 md:py-20">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-violet-700 dark:text-violet-400">Cosa possiamo collegare</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">Un flusso operativo, non una collezione di tool.</h2>
      <p class="mt-4 text-neutral-600 dark:text-neutral-300">
        Partiamo dal problema più costoso o ripetitivo e aggiungiamo soltanto le integrazioni necessarie.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {benefits.map((item) => (
        <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-800 dark:bg-neutral-900/60">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-violet-100 text-violet-700 dark:bg-violet-900/30 dark:text-violet-300">
            <Icon name={item.icon} class="h-5 w-5" />
          </div>
          <h3 class="text-lg font-semibold">{item.title}</h3>
          <p class="mt-2 leading-relaxed text-neutral-600 dark:text-neutral-300">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- AUTONOMIA -->
  <section class="container mx-auto max-w-6xl px-6 pb-14 md:pb-20">
    <div class="overflow-hidden rounded-3xl bg-neutral-950 p-8 text-white md:p-10">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-violet-300">Livelli di autonomia</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">Non esiste solo “automatico” oppure “manuale”.</h2>
        <p class="mt-5 leading-relaxed text-neutral-300">
          Il sistema parte dal livello più prudente. L’autonomia cresce soltanto quando gli errori sono osservabili, il costo di un errore è accettabile e il passaggio è reversibile.
        </p>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {autonomyLevels.map(([level, title, text]) => (
          <article class="rounded-2xl border border-white/10 bg-white/5 p-5">
            <div class="flex h-9 w-9 items-center justify-center rounded-full bg-violet-600 font-bold">{level}</div>
            <h3 class="mt-4 font-semibold text-violet-200">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-300">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- RELIABILITY -->
  <section class="border-y border-neutral-200 bg-neutral-50/70 dark:border-neutral-800 dark:bg-neutral-900/25">
    <div class="container mx-auto max-w-6xl px-6 py-14 md:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-violet-700 dark:text-violet-400">Reliability by design</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">Una demo deve funzionare una volta. Un processo deve funzionare ogni giorno.</h2>
      </div>

      <div class="mt-9 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {reliabilityItems.map(([title, text]) => (
          <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-800 dark:bg-neutral-900/60">
            <h3 class="font-semibold">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- COMPLIANCE -->
  <section class="container mx-auto max-w-6xl px-6 py-14 md:py-20">
    <div class="grid gap-8 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-violet-700 dark:text-violet-400">Uso responsabile</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">Privacy, trasparenza e persone fanno parte dell’implementazione.</h2>
        <p class="mt-5 leading-relaxed text-neutral-600 dark:text-neutral-300">
          Un workflow reale può toccare dati personali, account aziendali e comunicazioni verso clienti. Per questo la configurazione tecnica considera minimizzazione dei dati, accessi, conservazione, tracciabilità e trasparenza quando l’utente interagisce direttamente con un sistema AI.
        </p>
      </div>

      <div class="rounded-3xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-800 dark:bg-neutral-900/60">
        <ul class="space-y-3 text-neutral-700 dark:text-neutral-300">
          <li>• inventario di strumenti, provider e dati coinvolti</li>
          <li>• permessi e credenziali limitati al necessario</li>
          <li>• regole di retention e accesso da definire con il cliente</li>
          <li>• informazione chiara quando prevista per interazioni AI</li>
          <li>• breve handover operativo per chi userà o supervisionerà il sistema</li>
        </ul>
        <p class="mt-5 text-xs leading-relaxed text-neutral-500 dark:text-neutral-400">
          Questa parte riguarda l’implementazione tecnica e non sostituisce consulenza legale, privacy o DPO. Se il caso richiede valutazioni specialistiche, il cliente viene invitato a coinvolgere il proprio consulente.
        </p>
      </div>
    </div>
  </section>

  <!-- METODO -->
  <section id="metodo" class="border-y border-neutral-200 bg-neutral-50/70 dark:border-neutral-800 dark:bg-neutral-900/25 scroll-mt-28">
    <div class="container mx-auto max-w-6xl px-6 py-14 md:py-20">
      <div class="mb-10 max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-violet-700 dark:text-violet-400">Metodo operativo</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">Fit Check → Pilot → misura → monitoraggio.</h2>
      </div>

      <div class="grid gap-4 md:grid-cols-5">
        {phases.map(([title, text], i) => (
          <article class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm dark:border-neutral-800 dark:bg-neutral-900/60">
            <div class="mb-4 flex h-9 w-9 items-center justify-center rounded-full bg-violet-600 text-sm font-bold text-white">{i + 1}</div>
            <h3 class="font-semibold">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- OFFERTA -->
  <section class="container mx-auto max-w-6xl px-6 py-14 md:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-violet-700 dark:text-violet-400">Perimetro e costi</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">Prima compriamo evidenza, poi complessità.</h2>
      <p class="mt-4 text-neutral-600 dark:text-neutral-300">Il prezzo finale dipende da integrazioni, volumi e rischio operativo. Questi sono i punti di partenza.</p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      <article class="rounded-3xl border border-neutral-200 bg-white p-7 shadow-sm dark:border-neutral-800 dark:bg-neutral-900/60">
        <div class="text-sm font-semibold text-violet-700 dark:text-violet-300">01 · Process Fit Check</div>
        <div class="mt-3 text-4xl font-extrabold">290 €</div>
        <p class="mt-4 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">Analisi di un processo con baseline, dati, integrazioni, eccezioni, rischi e KPI. Conclusione esplicita: GO, PREPARARE o NO-GO.</p>
      </article>

      <article class="rounded-3xl border-2 border-violet-300 bg-violet-50/50 p-7 shadow-sm dark:border-violet-800 dark:bg-violet-950/20">
        <div class="text-sm font-semibold text-violet-700 dark:text-violet-300">02 · Pilot Operativo</div>
        <div class="mt-3 text-4xl font-extrabold">da 1.490 €</div>
        <p class="mt-4 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">Un workflow prioritario, integrazioni definite nel preventivo, test, gestione errori, livelli di autonomia, documentazione e osservazione iniziale post go-live.</p>
      </article>

      <article class="rounded-3xl border border-neutral-200 bg-white p-7 shadow-sm dark:border-neutral-800 dark:bg-neutral-900/60">
        <div class="text-sm font-semibold text-violet-700 dark:text-violet-300">03 · Operations Care</div>
        <div class="mt-3 text-4xl font-extrabold">da 249 €<span class="text-base font-medium text-neutral-500">/mese</span></div>
        <p class="mt-4 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">Monitoraggio, alert, controllo consumi, verifiche su API e integrazioni, piccole correzioni e report operativo. Nuovi workflow vengono quotati a parte.</p>
      </article>
    </div>

    <p class="mx-auto mt-6 max-w-3xl text-center text-xs leading-relaxed text-neutral-500 dark:text-neutral-400">
      Costi di API, licenze, WhatsApp/provider, hosting o altri servizi terzi sono separati e visibili prima del go-live.
    </p>
  </section>

  <!-- MODULO ASSISTENTE -->
  <section class="container mx-auto max-w-6xl px-6 pb-14 md:pb-20">
    <div class="rounded-2xl border border-violet-200 bg-violet-50 p-5 text-sm text-violet-950 dark:border-violet-900 dark:bg-violet-950/30 dark:text-violet-100">
      L’assistente AI per sito e WhatsApp resta disponibile come modulo specifico quando il processo richiede una conversazione con il cliente. <a href="/servizi/assistente-ai-sito-whatsapp" class="font-semibold underline underline-offset-2">Scopri l’assistente AI →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container mx-auto max-w-4xl px-6 pb-14 md:pb-20">
    <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Domande frequenti</h2>
    <div class="mt-6 space-y-3">
      {[
        ['Quando non conviene automatizzare?', 'Quando il processo è raro, instabile, privo di dati affidabili o richiede decisioni sensibili difficili da circoscrivere. In questi casi il Fit Check può concludersi con PREPARARE o NO-GO.'],
        ['Serve già un CRM?', 'No, ma deve esistere una destinazione affidabile per i dati. Se oggi tutto vive in email e fogli incoerenti, può essere necessario sistemare prima la base operativa.'],
        ['L’AI può agire senza approvazione?', 'Solo sui passaggi a basso rischio, reversibili e già testati. Per il resto usiamo modalità read-only, bozza o approvazione esplicita.'],
        ['Cosa succede se cambia un’API o un modulo del sito?', 'È uno dei motivi per cui esiste Operations Care: monitoraggio e alert servono a intercettare rotture prima che diventino giorni di lead o dati persi.'],
        ['Resto dipendente da LS Web Agency?', 'L’obiettivo è il contrario: documentiamo integrazioni, flussi e requisiti operativi. Dove possibile, credenziali e account restano intestati al cliente e definiamo una procedura di handover.'],
        ['È un servizio di compliance AI?', 'No. Applichiamo misure tecniche di trasparenza, minimizzazione, accesso e tracciabilità nel perimetro del progetto; le valutazioni legali e privacy specialistiche restano di competenza dei professionisti incaricati dal cliente.'],
      ].map(([q, a]) => (
        <details class="rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900/60">
          <summary class="cursor-pointer font-semibold">{q}</summary>
          <p class="mt-3 leading-relaxed text-neutral-600 dark:text-neutral-300">{a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-neutral-200 bg-neutral-950 text-white dark:border-neutral-800">
