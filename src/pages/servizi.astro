---
/**
 * /servizi — hub dei servizi · Redesign C.3.4
 * Gerarchia: 4 pratiche principali → percorso d'ingresso (prezzi dichiarati)
 * → percorsi secondari → lavori selezionati → doppio percorso.
 * Invariati: metadata, H1, ancore #servizi-principali e #ai, link alle pagine servizio.
 */
import Layout from '@/layouts/PageLayout.astro';
import C3PageHero from '@/components/c3/page/C3PageHero.astro';
import C3Section from '@/components/c3/page/C3Section.astro';
import C3Paths from '@/components/c3/page/C3Paths.astro';
import { PRACTICES, SECONDARY } from '@/data/c3/services';
import { SERVICES, PORTFOLIO, shotSrcset } from '@/data/c3/home';

// ✅ immagine esistente importata come ESM (evita MissingImageDimension) — usata per OG
import servicesHero from '@/assets/images/servizi-seo-grafica-branding-siti-web.webp';

const metadata = {
  title: 'Servizi web e digitali per PMI | LS Web Agency',
  description:
    'Audit, siti web, SEO, landing e automazioni leggere: scopri da quale intervento partire in base allo stato attuale della tua presenza online.',
  canonical: '/servizi',
  ignoreTitleTemplate: true,
  openGraph: {
    url: '/servizi',
    images: [{ url: servicesHero.src, width: servicesHero.width, height: servicesHero.height }],
    type: 'website',
  },
  twitter: {
    cardType: 'summary_large_image',
  },
};

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<Layout metadata={metadata} headerTone="dark">
  <div class="c3 c3p c4-service-hub">
    <C3PageHero
      kicker="Servizi"
      title="Servizi web e digitali: scegli da dove partire"
      accent="da dove partire"
      lead="Non tutti hanno bisogno dello stesso intervento. Se il sito è già online può essere utile partire da un audit; se manca, dal progetto. Qui trovi i servizi disponibili, come si combinano e il percorso più adatto alla situazione della tua attività."
      actions={[
        { text: 'Richiedi la valutazione gratuita', href: '/mini-analisi' },
        { text: 'Scopri le pratiche', href: '#servizi-principali', variant: 'secondary' },
      ]}
    >
      <dl class="c3-meta" slot="aside">
        <div><dt>Pratiche</dt><dd>Web design, UX/UI, front-end, prodotti digitali</dd></div>
        <div><dt>Formati</dt><dd>Progetti su misura, audit, sprint, cura continuativa</dd></div>
        <div><dt>Interlocutore</dt><dd>Luca Sanna, dal brief al rilascio</dd></div>
        <div><dt>Dove</dt><dd>Studio a Sassari · progetti in tutta Italia</dd></div>
      </dl>
    </C3PageHero>

    <C3Section
      tone="ivory"
      id="servizi-principali"
      index="01"
      kicker="Pratiche"
      title="Quattro competenze, un solo progetto."
      accent="un solo progetto."
      lead="Design, esperienza, codice e strumenti digitali nelle stesse mani: ogni pratica raccoglie i servizi che la rendono concreta."
    >
      <div class="c3-practices">
        {
          PRACTICES.map((p, i) => (
            <article class="c3-practice c3-up" id={p.id} aria-labelledby={`pratica-${i}`}>
              <span class="c3-practice-n">{String(i + 1).padStart(2, '0')}</span>
              <h3 id={`pratica-${i}`}>{p.title}</h3>
              <p>{p.desc}</p>
              <ul class="c3-practice-tags">
                {p.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
              <ul class="c3-linklist">
                {p.links.map((l) => (
                  <li>
                    <a href={l.href}>
                      <span class="c3-sr">Servizio: </span>
                      <div>
                        {l.label}
                        {l.note && <small>{l.note}</small>}
                      </div>
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </C3Section>

    <C3Section
      tone="deep"
      id="da-dove-partire"
      index="02"
      kicker="Da dove partire"
      title="Un percorso per gradi."
      lead="Non sempre serve rifare tutto. Prezzi di partenza dichiarati; se non sai quale passo fa per te, la valutazione iniziale è gratuita."
    >
      <ol class="c3-route">
        {
          SERVICES.map((s, i) => (
            <li class="c3-up">
              <span class="c3-route-n">Passo {i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <p class="c3-route-price">
                {s.price}
                <small>{s.priceNote}</small>
              </p>
              <a href={s.href}>{s.cta}</a>
            </li>
          ))
        }
      </ol>
    </C3Section>

    <C3Section
      tone="dark"
      id="percorsi-secondari"
      index="03"
      kicker="Percorsi secondari"
      title="Visibilità, settori e cura nel tempo."
      lead="Servizi che completano un progetto o rispondono a esigenze specifiche."
    >
      <div class="c3-cols">
        {
          SECONDARY.map((g) => (
            <div class="c3-col c3-up">
              <h3>{g.title}</h3>
              <p>{g.desc}</p>
              <ul class="c3-linklist">
                {g.links.map((l) => (
                  <li>
                    <a href={l.href} {...(isExternal(l.href) ? { target: '_blank', rel: 'noopener' } : {})}>
                      <div>{l.label}</div>
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </C3Section>

    <C3Section
      tone="ivory"
      id="lavori"
      index="04"
      kicker="Lavori selezionati"
      title="Dall’identità al codice."
      accent="al codice."
      lead="Progetti in cui design, sviluppo e prodotto sono stati seguiti dall’inizio alla fine."
    >
      <div class="c3-works">
        {
          PORTFOLIO.map((p) => (
            <a class="c3-work c3-up" href={`/portfolio/${p.id}`}>
              <span class="c3-work-img">
                <img src={p.shot} srcset={shotSrcset(p.shot)} sizes="(min-width: 1440px) 305px, (min-width: 1024px) 23vw, (min-width: 601px) 45vw, 90vw" alt={`Homepage del sito ${p.domain}`} width="800" height="500" loading="lazy" decoding="async" />
              </span>
              <strong>{p.name}</strong>
              <span>{p.role}</span>
            </a>
          ))
        }
      </div>
      <p class="c3-paths-note c3-up"><a href="/portfolio">Tutti i progetti →</a></p>
    </C3Section>

    <C3Paths index="05" />
  </div>
</Layout>
