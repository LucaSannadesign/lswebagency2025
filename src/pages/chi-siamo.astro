---
/**
 * /chi-siamo · Redesign C.3.4
 * Ritratto professionale dello studio indipendente di Luca Sanna: profilo,
 * formazione artistica, metodo, competenze (tecnologie realmente usate nei
 * progetti del portfolio), pubblici, principi. Nessuna illustrazione generica,
 * nessun team suggerito.
 * Invariati: title, description, H1.
 */
import Layout from '@/layouts/PageLayout.astro';
import C3PageHero from '@/components/c3/page/C3PageHero.astro';
import C3Section from '@/components/c3/page/C3Section.astro';
import C3Paths from '@/components/c3/page/C3Paths.astro';

const metadata = {
  title: 'Chi Siamo - LS Web Agency',
  description:
    'LS Web Agency è un progetto di Luca Sanna, web designer e developer con oltre 15 anni di esperienza nello sviluppo di siti web e applicazioni. Collaboriamo con esperti per offrire soluzioni digitali di alta qualità.',
};

const METHOD = [
  { t: 'Ascolto e analisi', d: 'Obiettivi, pubblico, vincoli e materiali esistenti. Se il sito c’è già, parto da cosa funziona e da cosa frena i contatti.' },
  { t: 'Struttura e direzione visiva', d: 'Architettura dei contenuti, gerarchie, percorsi e un linguaggio visivo coerente con l’identità del progetto.' },
  { t: 'Sviluppo su misura', d: 'Codice scritto per il progetto: veloce, accessibile, responsive e facile da aggiornare, con SEO tecnica e moduli integrati.' },
  { t: 'Lancio, misura e cura', d: 'Verifiche, pubblicazione e misurazione. Dopo il lancio intervengo sulle priorità, quando servono.' },
];

const SKILLS = [
  { t: 'Design', items: ['UX/UI e architettura dei contenuti', 'Brand identity e design grafico', 'Grafica editoriale e impaginazione'] },
  { t: 'Sviluppo front-end', items: ['HTML, CSS, JavaScript', 'Astro, React, Tailwind CSS', 'Accessibilità e performance'] },
  { t: 'Creative development', items: ['WebGL e shader', 'Animazioni con riduzione del movimento', 'Prototipi interattivi'] },
  { t: 'Piattaforme e dati', items: ['WordPress, WooCommerce, Drupal', 'Supabase, Vercel', 'SEO tecnica e misurazione'] },
];

const AUDIENCES = [
  {
    t: 'Aziende e professionisti',
    d: 'Progetti strutturati: un nuovo sito, il rifacimento di una piattaforma, un prodotto digitale con obiettivi chiari.',
    href: '/servizi',
    cta: 'Le pratiche dello studio',
  },
  {
    t: 'Agenzie e partner tecnologici',
    d: 'Sviluppo front-end e design in collaborazione, con perimetro definito e lavoro riservato: il cliente resta vostro.',
    href: '/servizi/sviluppo-web-white-label',
    cta: 'Collaborazioni white label',
  },
  {
    t: 'Clienti internazionali',
    d: 'Creative development, UX/UI e sviluppo web su misura, a distanza. Lavoro in italiano e in inglese.',
    href: '/contatti#progetto-strutturato',
    cta: 'Write to me in English',
  },
];

const PRINCIPLES = [
  { t: 'Trasparenza', d: 'Prezzi di partenza dichiarati e stato reale di ogni progetto in portfolio.' },
  { t: 'Qualità verificabile', d: 'Siti veloci, accessibili e sicuri, controllati prima e dopo la pubblicazione.' },
  { t: 'Risultati misurati', d: 'Riporto metriche e risultati solo quando sono misurati e verificabili.' },
  { t: 'Continuità', d: 'Un solo interlocutore dal primo confronto alla manutenzione.' },
];
---

<Layout metadata={metadata} headerTone="dark">
  <div class="c3 c3p">
    <C3PageHero
      kicker="Chi siamo"
      title="Strategie Digitali e Creazione Siti Web su Misura"
      accent="su Misura"
      lead="LS Web Agency è lo studio indipendente di Luca Sanna: progetto e sviluppo siti e prodotti digitali per aziende e professionisti, con cura per SEO, accessibilità e performance."
      actions={[
        { text: 'Parla con Luca', href: '/contatti' },
        { text: 'Vedi lavori', href: '/portfolio', variant: 'secondary' },
      ]}
    >
      <dl class="c3-meta" slot="aside">
        <div><dt>Fondatore</dt><dd>Luca Sanna, web designer e developer</dd></div>
        <div><dt>Esperienza</dt><dd>Oltre 15 anni di siti web e applicazioni</dd></div>
        <div><dt>Base</dt><dd>Sassari · da remoto in tutta Italia</dd></div>
        <div><dt>Lingue</dt><dd>Italiano, inglese</dd></div>
      </dl>
    </C3PageHero>

    <C3Section tone="ivory" id="profilo" index="01" kicker="Profilo" title="Un designer che scrive il codice." accent="scrive il codice.">
      <div class="c3-phero-grid">
        <div class="c3-up">
          <p class="c3-stmt-s">
            <strong>LS Web Agency</strong> è un progetto fondato da <strong>Luca Sanna</strong>, web designer e developer con
            oltre 15 anni di esperienza nello sviluppo di siti web e applicazioni.
          </p>
          <p class="c3-lead">
            Vengo dalla pittura e dalla grafica: composizione, colore e gerarchia sono il punto di partenza di ogni
            interfaccia. Poi viene il codice, scritto per il progetto e non adattato da un tema. Seguo ogni lavoro in prima
            persona, dal primo confronto al rilascio e alla manutenzione.
          </p>
        </div>
        <dl class="c3-meta c3-up">
          <div>
            <dt>Formazione</dt>
            <dd>
              Artistica, con una pratica pittorica attiva ·
              <a class="c3-link" href="/portfolio/luca-sanna-artista-sardo-sassari">il lavoro artistico</a>
            </dd>
          </div>
          <div><dt>Ruolo</dt><dd>Direzione visiva, UX/UI e sviluppo front-end</dd></div>
          <div><dt>Interlocutore</dt><dd>Uno solo, per tutto il progetto</dd></div>
          <div><dt>Progetti propri</dt><dd>PreventivoDentale, Canapalandia, LUGHE, YoArtly</dd></div>
        </dl>
      </div>
    </C3Section>

    <C3Section tone="deep" id="metodo" index="02" kicker="Metodo" title="Quattro tempi, nessun passaggio di mano.">
      <ol class="c3-route">
        {
          METHOD.map((m, i) => (
            <li class="c3-up">
              <span class="c3-route-n">Tempo {i + 1}</span>
              <h3>{m.t}</h3>
              <p>{m.d}</p>
            </li>
          ))
        }
      </ol>
    </C3Section>

    <C3Section
      tone="ivory"
      id="competenze"
      index="03"
      kicker="Competenze e strumenti"
      title="Dal segno all’interfaccia."
      accent="all’interfaccia."
      lead="Gli strumenti elencati sono quelli usati nei progetti pubblicati nel portfolio e in questo sito."
    >
      <div class="c3-cols">
        {
          SKILLS.map((s) => (
            <div class="c3-col c3-up">
              <h3>{s.t}</h3>
              <ul class="c3-practice-tags" style="display:grid;gap:8px">
                {s.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </C3Section>

    <C3Section tone="anth" id="con-chi-lavoro" index="04" kicker="Con chi lavoro" title="Tre modi di collaborare.">
      <div class="c3-cols">
        {
          AUDIENCES.map((a) => (
            <div class="c3-col c3-up">
              <h3>{a.t}</h3>
              <p>{a.d}</p>
              <ul class="c3-linklist">
                <li>
                  <a href={a.href} {...(a.cta.startsWith('Write') ? { lang: 'en' } : {})}>
                    <div>{a.cta}</div>
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              </ul>
            </div>
          ))
        }
      </div>
    </C3Section>

    <C3Section tone="dark" id="principi" index="05" kicker="Principi" title="Come lavoro, in concreto.">
      <div class="c3-cols">
        {
          PRINCIPLES.map((p) => (
            <div class="c3-col c3-up">
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </div>
          ))
        }
      </div>
    </C3Section>

    <C3Paths index="06" />
  </div>
</Layout>

<style is:global>
  .c3-stmt-s {
    margin: 0 0 24px;
    font: 600 clamp(26px, 2.8vw, 40px) / 1.15 var(--c3-disp);
    font-stretch: 86%;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
</style>
