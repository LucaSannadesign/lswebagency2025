---
import Layout from '@/layouts/PageLayout.astro';
import C3PageHero from '@/components/c3/page/C3PageHero.astro';
import MiniAnalisiWidget from '@/components/MiniAnalisi';

// === SEO ===
const metadata = {
  title: 'Valutazione iniziale gratuita — LS Web Agency',
  description:
    'Rispondi a poche domande, indica il tuo sito e ottieni un primo orientamento gratuito su priorità e prossimo passo. Puoi richiedere anche una verifica preliminare del sito; non sostituisce un audit tecnico completo.',
  canonical: '/mini-analisi',
  robots: { index: true, follow: true },
};
---

<Layout metadata={metadata} headerTone="dark">
  <!-- HERO -->
  <div class="c3 c3p">
    <C3PageHero kicker="Strumento gratuito · senza impegno" title="Valutazione iniziale gratuita" accent="gratuita" size="l" visual="flow" lead="Rispondi a poche domande e individua le priorità del tuo progetto. Se hai già un sito, puoi anche richiedere una verifica preliminare gratuita." />
  </div>

  <!-- MINI‑ANALISI -->
  <section class="container mx-auto px-6 pb-16">
    <div class="max-w-2xl mx-auto">
      <MiniAnalisiWidget client:visible />

      <div class="mt-6 rounded-2xl p-5 ring-1 ring-neutral-200 dark:ring-neutral-800 bg-white/70 dark:bg-neutral-900/50">
        <h2 class="text-sm font-semibold text-neutral-800 dark:text-neutral-200">Cosa ottieni con la valutazione iniziale gratuita</h2>
        <ul class="mt-2 space-y-1.5 text-sm text-neutral-600 dark:text-neutral-300">
          <li>• Una prima lettura delle priorità in base alle informazioni che inserisci.</li>
          <li>• Un’indicazione del servizio o del prossimo passo più adatto al tuo caso.</li>
          <li>• Se indichi il sito e autorizzi la verifica, puoi richiedere un controllo preliminare dei problemi più evidenti di chiarezza, messaggio e percorso verso il contatto.</li>
          <li>• Non include un audit tecnico completo, né un report professionale con screenshot, finding strutturati e roadmap.</li>
          <li>• Per UX, SEO tecnica, performance e accessibilità resta disponibile l’<a href="/servizi/audit-rapido" class="underline hover:text-neutral-900 dark:hover:text-white">Audit del sito</a>.</li>
        </ul>
      </div>

      <p class="mt-4 text-center text-xs text-neutral-500 dark:text-neutral-400">
        La valutazione iniziale è gratuita e non sostituisce un audit tecnico completo.
      </p>
    </div>
  </section>
</Layout>
