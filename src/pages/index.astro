/* ─────────────────────────────────────────────
   SCHEMA — FAQPage (stessa fonte delle FAQ visibili)
───────────────────────────────────────────── */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const WHATSAPP =
  'https://wa.me/393403223494?text=Ciao%2C%20vorrei%20informazioni%20sui%20servizi%20LS%20Web%20Agency.';
---

<Layout metadata={metadata} variant="c3">
  <Fragment slot="head">
    <link rel="preload" href="/fonts/archivo/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <C3Hero />
  <C3Portfolio />
  <C3Skills />
  <C3Services />
  <C3About />
  <C3Reviews />
  <C3Faq />
  <C3Blog posts={APP_BLOG.isEnabled ? latestPosts.slice(0, 4) : []} />

  <!-- ═══════════════════════════════════════
       CONTATTI — form → POST /api/contatti
       Logica invariata (coperta da tests/formHandlerBinding.test.mjs):
       honeypot, campi strutturati phone/service, errori API, guardia doppio
       binding, inizializzazione su astro:page-load.
  ════════════════════════════════════════ -->
  <section class="c3-band c3-contact" id="contatti" data-c3-chapter="dark" aria-labelledby="c3-h-con">
    <p class="c3-kicker">Contatti</p>
    <h2 id="c3-h-con" style="margin:0"><a class="c3-big-cta" href="#contact-form">Parliamo del tuo progetto.</a></h2>
    <div class="c3-c-grid">
      <ul class="c3-direct">
        <li><span>Email</span><a href="mailto:info@lswebagency.com">info@lswebagency.com</a></li>
        <li><span>Telefono</span><a href="tel:+393403223494">+39 340 322 3494</a></li>
        <li>
          <span>WhatsApp</span><a href={WHATSAPP} target="_blank" rel="noopener noreferrer">Scrivimi su WhatsApp</a>
        </li>
        <li><span>Studio</span><div>Via Alcide De Gasperi 3<br />07100 Sassari (SS)</div></li>
        <li><span>Tempi</span><div>Risposta entro 24–48 ore</div></li>
      </ul>

      <div>
        <form id="contact-form" class="c3-form">
          <!-- Honeypot anti-spam -->
          <input type="text" name="ref_note" tabindex="-1" autocomplete="off" class="c3-hp" aria-hidden="true" />
          <label for="name">Nome e cognome
            <input type="text" name="name" id="name" autocomplete="name" placeholder="Il tuo nome" required />
          </label>
          <label for="email">Email
            <input type="email" name="email" id="email" autocomplete="email" placeholder="nome@esempio.it" required />
          </label>
          <label for="phone" class="c3-form-full">Telefono (opzionale)
            <input type="tel" name="phone" id="phone" autocomplete="tel" />
          </label>
          <label for="need">Di cosa hai bisogno?
            <select id="need" name="need">
              <option value="">Seleziona una voce</option>
              <option value="Ho già un sito da migliorare">Ho già un sito da migliorare</option>
              <option value="Devo creare un sito da zero">Devo creare un sito da zero</option>
              <option value="Voglio più visibilità locale">Voglio più visibilità locale</option>
              <option value="Vorrei un audit o una valutazione iniziale">Vorrei un audit o una valutazione iniziale</option>
              <option value="Altro">Altro</option>
            </select>
          </label>
          <label for="budget">Budget indicativo
            <select id="budget" name="budget" aria-describedby="budget-help">
              <option value="Preferisco indicarlo dopo">Preferisco indicarlo dopo</option>
              <option value="Meno di 500 €">Meno di 500 €</option>
              <option value="500–1.000 €">500–1.000 €</option>
              <option value="1.000–2.000 €">1.000–2.000 €</option>
              <option value="Oltre 2.000 €">Oltre 2.000 €</option>
              <option value="Non lo so ancora">Non lo so ancora</option>
            </select>
            <span class="c3-help" id="budget-help">Serve solo a capire quale percorso proporti, non è un vincolo.</span>
          </label>
          <label for="textarea" class="c3-form-full">Messaggio
            <textarea
              id="textarea"
              name="message"
              rows={5}
              placeholder="Parlaci del tuo sito o della tua attività…"
              minlength="10"
              required
              aria-describedby="message-help"></textarea>
            <span class="c3-help" id="message-help">Scrivi almeno 10 caratteri.</span>
          </label>
          <label for="disclaimer" class="c3-form-full c3-chk">
            <input id="disclaimer" name="disclaimer" type="checkbox" required />
            <span>Ho letto e accetto la <a href="/privacy">Privacy Policy</a> (obbligatorio).</span>
          </label>
          <div class="c3-form-full">
            <p id="contact-form-status" role="status" aria-live="polite"></p>
            <button class="c3-btn c3-btn--p" type="submit">
              Invia la richiesta
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </button>
          </div>
        </form>
        <p class="c3-alt">
          Preferisci partire da qualche domanda guidata? <a class="c3-link" href="/mini-analisi">Avvia la valutazione iniziale gratuita</a>
        </p>
      </div>
    </div>

      <script>
        function setStatus(el: HTMLElement | null, text: string, kind: 'idle' | 'load' | 'ok' | 'err') {
          if (!el) return;
          el.textContent = text;
          el.classList.toggle('is-ok', kind === 'ok');
          el.classList.toggle('is-err', kind === 'err');
        }

        type ContactResponse = {
          ok?: boolean;
          message?: string;
          fields?: Record<string, string>;
        };

        // L'API può rispondere con un messaggio generale, con l'elenco dei campi
        // non validi, o con entrambi: qui vengono uniti in un unico testo, così
        // l'utente vede sempre il motivo reale del rifiuto.
        function describeError(body: ContactResponse, fallback: string): string {
          const parts: string[] = [];
          if (typeof body.message === 'string' && body.message.trim()) {
            parts.push(body.message.trim());
          }
          if (body.fields && typeof body.fields === 'object') {
            for (const value of Object.values(body.fields)) {
              if (typeof value === 'string' && value.trim() && !parts.includes(value.trim())) {
                parts.push(value.trim());
              }
            }
          }
          return parts.length ? parts.join(' ') : fallback;
        }

        // Budget resta nel corpo del messaggio: non ha un campo dedicato lato API.
        // Telefono e servizio viaggiano invece come campi strutturati.
        function buildMessage(formData: FormData): string {
          const budget = String(formData.get('budget') || '').trim();
          const body = String(formData.get('message') || '').trim();
          if (budget && budget !== 'Preferisco indicarlo dopo') {
            return `Budget indicativo: ${budget}\n\n${body}`;
          }
          return body;
        }

        function attachContactFormHandler() {
          const form = document.getElementById('contact-form');
          if (!form || !(form instanceof HTMLFormElement)) return;

          // Guardia anti doppio binding: con ClientRouter la stessa pagina può
          // essere ri-annunciata più volte e il submit partirebbe due volte.
          if (form.dataset.contactFetchBound === '1') return;
          form.dataset.contactFetchBound = '1';

          const statusEl = document.getElementById('contact-form-status');
          const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');

          form.addEventListener('submit', async (event) => {
            event.preventDefault();

            if (submitBtn) submitBtn.disabled = true;
            setStatus(statusEl, 'Invio in corso…', 'load');

            const formData = new FormData(form);
            const payload = {
              name: String(formData.get('name') || ''),
              email: String(formData.get('email') || ''),
              // Campi strutturati: prima finivano dentro al testo del messaggio
              // e non arrivavano mai nelle colonne dedicate del CRM.
              phone: String(formData.get('phone') || '').trim(),
              // `service` è il campo che l'API mappa su `service_interest`.
              service: String(formData.get('need') || '').trim(),
              message: buildMessage(formData),
              privacy: formData.get('disclaimer') === 'on',
              ref_note: String(formData.get('ref_note') || ''),
            };

            try {
              const res = await fetch('/api/contatti', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload),
              });
              let body: ContactResponse = {};
              try {
                body = await res.json();
              } catch {
                body = {};
              }

              if (res.ok && body.ok === true) {
                const msg =
                  typeof body.message === 'string' ? body.message : 'Messaggio inviato con successo.';
                setStatus(statusEl, msg, 'ok');
                form.reset();
              } else {
                setStatus(statusEl, describeError(body, 'Richiesta non riuscita.'), 'err');
              }
            } catch {
              setStatus(statusEl, 'Connessione non riuscita. Riprova.', 'err');
            } finally {
              if (submitBtn) submitBtn.disabled = false;
            }
          });
        }

        // Con ClientRouter attivo lo script del modulo non viene rieseguito a ogni
        // navigazione: senza `astro:page-load` il form ricostruito dal router
        // resta senza handler e la richiesta si perde.
        document.addEventListener('astro:page-load', attachContactFormHandler);

        // Fallback per il primo caricamento e per eventuali pagine senza router.
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', attachContactFormHandler);
        } else {
          attachContactFormHandler();
        }
      </script>
  </section>

  <script>
    import '@/scripts/c3/home';
  </script>
</Layout>
