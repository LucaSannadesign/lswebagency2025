import { findLatestPosts } from '@/utils/blog';
import { APP_BLOG } from 'astrowind:config';
import '@/styles/c3/tokens.css';
import '@/styles/c3/home.css';

const latestPosts = APP_BLOG.isEnabled ? await findLatestPosts({ count: 4 }) : [];

/* ─────────────────────────────────────────────
   META + SEO
───────────────────────────────────────────── */
const metadata = {
  title: 'Siti web a Sassari per acquisire clienti | LS Web Agency',
  description:
    'Realizzo siti web a Sassari per PMI e professionisti: progetti veloci, chiari e orientati ai contatti, con SEO, moduli e tracciamento integrati.',
  canonical: '/',
  robots: { index: true, follow: true },
  openGraph: {
    url: 'https://www.lswebagency.com/',
    type: 'website',
    images: [
      {
        url: 'https://www.lswebagency.com/images/og-home.jpg',
        width: 1200,
        height: 630,
        alt: 'LS Web Agency — siti web strategici per acquisire clienti, da Sassari in tutta Italia',
      },
    ],
  },
  twitter: {
    cardType: 'summary_large_image',
    handle: '@lswebagency',
    site: '@lswebagency',
  },
  ignoreTitleTemplate: true,
};

/* ─────────────────────────────────────────────
   SCHEMA — LocalBusiness
───────────────────────────────────────────── */
const localBusinessSchema = {
