import Layout from '@/layouts/PageLayout.astro';
import C3Hero from '@/components/c3/C3Hero.astro';
import C3Portfolio from '@/components/c3/C3Portfolio.astro';
import C3Skills from '@/components/c3/C3Skills.astro';
import C3Services from '@/components/c3/C3Services.astro';
import C3About from '@/components/c3/C3About.astro';
import C3Reviews from '@/components/c3/C3Reviews.astro';
