---
import Document from '@/layouts/Layout.astro';
import Header from '@/components/widgets/Header.astro';
import Footer from '@/components/widgets/Footer.astro';
import CookieBanner from '@/components/CookieBanner.astro'; // ✅ ADD
import SiteAssistant from '@/components/SiteAssistant';
import C3Header from '@/components/c3/C3Header.astro';
import C3Footer from '@/components/c3/C3Footer.astro';
import '@/styles/c3/tokens.css';
import '@/styles/c3/chrome.css';
import type { MetaData } from '@/types';

export interface Props {
  metadata?: MetaData;
  /**
   * 'c3' = homepage Kinetic Graphite (pagina interamente sotto .c3).
   * 'default' = pagine interne: contenuto invariato, header e footer C.3.
   * 'legacy' = header e footer storici (riserva, non usata).
   */
  variant?: 'default' | 'c3' | 'legacy';
  /**
   * Tono dell'header C.3 in cima alla pagina: 'light' (testo scuro, pagine con
   * testata chiara) o 'dark' (testo avorio, pagine con testata grafite C.3.4).
   */
  headerTone?: 'light' | 'dark';
}
const metadata = (Astro.props.metadata ?? {}) as MetaData;
const variant = Astro.props.variant ?? 'default';
const headerTone = Astro.props.headerTone ?? 'light';

// Assistente di sito (widget flottante): montato globalmente UNA sola volta, idratazione lazy.
// Escluso dalla pagina che ha già demo + assistente inline (evita sovraccarico): la decisione
// usa il pathname reale lato server, così il componente NON viene proprio renderizzato lì
// (nessuna logica client per nasconderlo dopo il caricamento).
const pathname = Astro.url.pathname;
const hideSiteAssistant =
  pathname === '/servizi/assistente-ai-sito-whatsapp' ||
  pathname === '/servizi/assistente-ai-sito-whatsapp/';
// WhatsApp: solo la variabile PUBLIC_ già usata nel progetto (SiteAssistant, pagina servizio).
// Se assente, il componente funziona senza WhatsApp (nessun numero hardcoded, nessuna env server).
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || undefined;
---

<Document metadata={metadata}>
  <Fragment slot="head"><slot name="head" /></Fragment>

  {
    variant === 'c3' ? (
      <div id="c3-root" class="c3" data-tone="dark">
        <a class="c3-skip" href="#main">Vai al contenuto</a>
        <C3Header />
        <main id="main">
          <slot />
        </main>
        <C3Footer />
      </div>
    ) : variant === 'legacy' ? (
      <>
        <Header />
        <main id="main" class="min-h-screen">
          <slot />
        </main>
        <Footer />
      </>
    ) : (
      <>
        <div class="c3 c3-chrome" data-tone={headerTone}>
          <a class="c3-skip" href="#main">Vai al contenuto</a>
          <C3Header mode="page" />
        </div>
        <main id="main" class="min-h-screen">
          <slot />
        </main>
        <div class="c3 c3-chrome-foot" data-tone="dark">
          <C3Footer />
        </div>
      </>
    )
  }

  <!-- ✅ Cookie banner / preferenze -->
  <CookieBanner />

  <!-- Scroll to top -->
  <button
    id="scrollToTop"
    type="button"
    aria-label="Torna su"
    class="c3-totop opacity-0 translate-y-2 pointer-events-none"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <path d="M12 19V5M6 11l6-6 6 6"></path>
    </svg>
  </button>

  <script is:inline>
    (() => {
      const btn = document.getElementById('scrollToTop');
      if (!btn) return;

      const SHOW_AT = 300;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const onScroll = () => {
        const y = window.scrollY || document.documentElement.scrollTop || 0;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        btn.style.setProperty('--p', max > 0 ? Math.min(1, y / max).toFixed(3) : '0');
        if (y > SHOW_AT) {
          btn.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
          btn.classList.add('opacity-100', 'translate-y-0');
        } else {
          btn.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
          btn.classList.remove('opacity-100', 'translate-y-0');
        }
      };

      btn.addEventListener('click', () => {
        try {
          window.scrollTo({ 
            top: 0, 
            behavior: prefersReducedMotion ? 'auto' : 'smooth' 
          });
        } catch {
          window.scrollTo(0, 0);
        }
      });

      // Keyboard navigation support
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          btn.click();
        }
      });

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>

  <!-- Assistente di sito: una sola istanza, idratazione lazy (client:idle). Non montato sulla
       pagina che ha già demo + assistente inline. Re-mount alla navigazione ClientRouter accettato
       (la conversazione è volutamente solo nello stato React). -->
  {!hideSiteAssistant && <SiteAssistant client:idle whatsappNumber={whatsappNumber} />}
</Document>